//******************************************************************************
// アスタロト＋フルフル ランダムトーク辞書 v3（2026-11-03、増強原稿 TALKS_EXPANSION.md 実装）
// 設計: FURFUR_DESIGN.md / 原稿: TALKS_EXPANSION.md（ユーザ承認済み）
//
// v3 の変更点（v2 は全44本）:
//   ・A 独白への突っ込み追加: 既存独白20本（アスタロト10＋フルフル10）の元の台詞は
//     一字も変えず、末尾に相方の一言（1〜2行）を追加した改訂版に置き換えた。
//   ・B 新規掛け合い40本を TalkDuo に追加（24→64本）。
//   ・C 時間帯フレーバー短編16本を時間帯プール（TalkTime*）として分離。
//     運用総数: 64＋10＋10＋16＝100本。
//   ・選択ロジックを履歴方式に拡張（下記）。
//
// 発動の仕組み:
//   yaya_base の SHIORI3EV.OnAITalkNewEvent が、OnAiTalk 系の関数が
//   無い場合に RandomTalk を呼ぶ。間隔は変数 aitalkinterval（秒）で、
//   起動時に astaroth_menu.dic の TalkFreqApply が保存済み設定を反映する
//   （未設定なら 420＝7分。頻度は当初案の半分程度というユーザーの希望、
//   2026-11-03）。v2.17 からは右クリックメニューの「トーク頻度の設定」で
//   180（約3分）／420（約7分）／900（約15分）／0（停止）を切り替えられ、
//   選択は再起動後も保持される。
//   （システム既定 TALK_INTERVAL は 180）
//
// 候補の選び方（v3）:
//   RandomTalk は決定的関数として再実装した。TalkSelectOne が乱数でプールを
//   選び（時間帯プール25％／掛け合い45％／アスタロト独白15％／フルフル独白15％）、
//   選ばれた台詞が直近5回（変数 astaroth_talkhistory）の履歴に一致したら、
//   最大12回まで引き直す。これにより従来の : nonoverlap（同一関数の直前回避）に
//   加えて、プールをまたいだ直近5回分の重複も避けられる。帯プールが3〜4本と
//   少ない時間帯トークの連続選出も、この履歴で抑えられる。
//   各プール関数には従来どおり : nonoverlap も併用している。
//
// サーフェス対応:
//   アスタロト \0: 0=通常 1=笑顔 2=驚き 3=呆れ 4=照れ 5=目閉じ
//   フルフル   \1: 10=通常 11=満面の笑顔 12=驚き 13=拗ね 14=照れ・恋 15=目閉じ
//   アスタロト ポーズ（v3.1、2026-11-03 シェル拡充第一弾）:
//     6=手を重ねる 7=手を合わせ俯く 8=本を抱える 9=腕組み
//     表情違いは基番＋40 の帯: 46=6+笑顔 47=7+目閉じ 48=8+笑顔 49=9+通常
//     割り当て方針（SHELL_EXPANSION.md §1）: 本の話→8/48、偉そう・命令・小言→9、
//     心配・謝罪・気遣い→7、素直な立ち・穏やかな独白→6。台詞本文は無変更で、
//     アスタロト側のサーフェス指定だけを該当箇所で差し替えた。
//   フルフル ポーズ（v3.2、2026-11-03 シェル拡充フルフル分）:
//     16=身を乗り出す 17=両手を広げて喜ぶ 18=拗ねてそっぽ 19=両手を合わせてお願い
//     表情違いは基番＋40 の帯: 56=16+照れ 57=17+目閉じ 58=18+驚き 59=19+笑顔
//     割り当て方針（SHELL_EXPANSION.md §1.2）: マスターへ迫る・気遣いの押し→16、
//     喜び・応援・自己紹介→17、拗ね・26/34ネタの回収→18、夢の約束→19、
//     恋の告白の押し→56、振り向きの驚き→58、おねだりの笑顔→59。
//     台詞本文は無変更で、フルフル側のサーフェス指定だけを該当箇所で差し替えた。
//   座りポーズ（v3.3、2026-11-03 シェル拡充第二弾）:
//     20=アスタロト座り 21=フルフル座り
//     割り当て方針（SHELL_EXPANSION.md §1）: 夜の静かな思考→20、
//     夜のまったりした掛け合い→21。台詞本文は無変更で、
//     サーフェス指定だけを該当箇所（計2箇所）で差し替えた。
//******************************************************************************

//******************************************************************************
//テスト用フック OnFurfurTalkTest
// SSTP NOTIFY（Event: OnFurfurTalkTest）を送ると、間隔を待たずに
// ランダムトークを1本即座に返す（実機確認用。OnAstarothHourlyTest と同型）。
// 送信スクリプトは astaroth-ghost/sstp_talktest.py（WSL内で実行）。
//******************************************************************************
OnFurfurTalkTest
{
	RandomTalk
}

//******************************************************************************
//ランダムトーク入口（履歴つき選出）
// 直近5回と重ならない台詞が引けるまで TalkSelectOne を最大12回引き直す。
// 12回すべて重なった場合は最後に引いたものをそのまま返す（無限ループ回避）。
//******************************************************************************
RandomTalk
{
	_talk = ''
	_sign = 0
	if ISVAR('astaroth_signboard') {
		_sign = TOINT(astaroth_signboard)
	}
	if _sign != 0 {
		//看板表示中は通常トークを止め、看板越しの呟きに差し替える
		//（astaroth_signboard.dic の SignboardMutter。状態変数はそちらで管理）
		_talk = SignboardMutter
	}
	else {
		_done = 0
		_count = 0
		while _done == 0 && _count < 12 {
			_talk = TalkSelectOne
			_count += 1
			if TalkInHistory(_talk) == 0 {
				_done = 1
			}
		}
		TalkPushHistory(_talk)
	}
	_talk
}

//******************************************************************************
//プール振り分け（乱数100分率）
//   0〜24 : 時間帯プール（現在時刻の帯）＝25％
//   25〜69: 掛け合い TalkDuo ＝45％
//   70〜84: アスタロト独白 TalkAstarothSolo ＝15％
//   85〜99: フルフル独白 TalkFurfurSolo ＝15％
// 元の比率（掛け合い6割／独白2割／独白2割）から時間帯プール25％を先に取り、
// 残り75％を 6:2:2 で割った配分。
//******************************************************************************
TalkSelectOne
{
	_r = RAND(100)
	_s = ''
	if _r < 25 {
		_s = EVAL(TalkTimeBandFunc)
	}
	elseif _r < 70 {
		_s = TalkDuo
	}
	elseif _r < 85 {
		_s = TalkAstarothSolo
	}
	else {
		_s = TalkFurfurSolo
	}
	_s
}

//******************************************************************************
//現在時刻の帯に対応する時間帯プール関数名を返す
// 朝 6-10時／昼 11-15時／夕 16-19時／夜 20-22時／深夜 23-5時
//（TALKS_EXPANSION.md の帯定義に準拠。GETTIME[4]=時、時報辞書と同じ取得法）
//******************************************************************************
TalkTimeBandFunc
{
	_h = TOINT(GETTIME[4])
	_f = 'TalkTimeMidnight'
	if _h >= 6 && _h <= 10 {
		_f = 'TalkTimeMorning'
	}
	elseif _h >= 11 && _h <= 15 {
		_f = 'TalkTimeNoon'
	}
	elseif _h >= 16 && _h <= 19 {
		_f = 'TalkTimeEvening'
	}
	elseif _h >= 20 && _h <= 22 {
		_f = 'TalkTimeNight'
	}
	_f
}

//******************************************************************************
//選出履歴（グローバル変数 astaroth_talkhistory、直近5件を保持）
//******************************************************************************
TalkInHistory
{
	_found = 0
	if ISVAR('astaroth_talkhistory') {
		for _i = 0 ; _i < ARRAYSIZE(astaroth_talkhistory) ; _i++ {
			if astaroth_talkhistory[_i] == _argv[0] {
				_found = 1
			}
		}
	}
	_found
}

TalkPushHistory
{
	if ISVAR('astaroth_talkhistory') == 0 {
		astaroth_talkhistory = IARRAY
	}
	astaroth_talkhistory ,= _argv[0]
	while ARRAYSIZE(astaroth_talkhistory) > 5 {
		_new = IARRAY
		for _i = 1 ; _i < ARRAYSIZE(astaroth_talkhistory) ; _i++ {
			_new ,= astaroth_talkhistory[_i]
		}
		astaroth_talkhistory = _new
	}
}

//******************************************************************************
//掛け合い（64本 = 既存24本＋新規40本）
//******************************************************************************
TalkDuo : nonoverlap
{
	'\0\s[0]……貴方、聞こえた？\w8\1\s[16]マスター、最近ドキドキしてるー？\w8してないなら私が恋、落としてあげる！ドカーン！\0\s[3]落とすのは雷だけで十分よ。\w8貴方はふわふわにしなくていい。\e'
	'\1\s[11]私は72柱の26番目！\w8雷と愛の堕天使だよー！\0\s[3]34番目。\w826はあんたの軍団数でしょう、何度言わせるの。\1\s[18]えへへ、紛らわしいのが悪いのー！\0\s[3]開き直るのはやめなさい。\e'
	'\1\s[11]ねえ見て、今の雷ピンクで可愛かったでしょ！\0\s[3]落とす前に許可を取りなさい。\w8デスクトップが焦げるでしょう。\1\s[10]大丈夫、気持ちだけ落としたの！\0\s[3]気持ちで落ちる雷が一番危ないわ。\e'
	'\1\s[19]ねえマスター、夢の約束覚えてる？\w8次は業火の泉で恋バナの続きだよー！\0\s[0]連れて行くとは言ったけれど、条件はあんたが騒ぎすぎないこと。\w8覚えている？\1\s[14]静かにドカーンする！\0\s[3]それを騒ぐと言うの。\e'
	'\1\s[10]ロトちゃん、この本なんて書いてあるの？\0\s[3]まず本を正しい向きに持ちなさい。\w8……それと、今ロトちゃんって言った？\1\s[11]えへへ、聞こえちゃった？\0\s[3]ごまかさないで。\e'
	'\1\s[10]マスター、好きな人にはね、真っ直ぐ「好き！」って言うのが一番だよ！\0\s[0]あんたの助言はいつも直球しかないわね。\1\s[11]変化球はアスタロトの皮肉で足りてるもん！\0\s[2]……上手いこと言ったつもり？\e'
	'\1\s[11]私の方が2センチ高いんだよね！\w8先輩って呼んでいいよ、アスタロト！\0\s[3]150と148よ。\w8貴族の格は身長で決まらないわ。\1\s[11]じゃあ私は身長担当大臣！\0\s[3]そんな役職、地獄にない。\e'
	'\1\s[11]昨日ね、私の雷で月がちょっと欠けたんだよ！\0\s[0]月は満ち欠けするものよ、あんたの雷のせいじゃない。\1\s[12]えっ、そうなの？\w8じゃあ私の雷、届いてなかった？\0\s[1]届いていたら大問題でしょう。\e'
	'\1\s[11]マスターを恋でふわふわにする計画、今日こそ成功させる！\0\s[1]貴方、聞こえた？\w8あんたの堕落は、私が許可してからにしなさい。\1\s[18]アスタロトはいつもそうやって独り占めするー！\0\s[4]ど、独り占めじゃないわよ……。\e'
	'\1\s[10]私の翼、パタパタすると光るんだよ！\w8アスタロトの輪っかも光るけど、動かないもんね。\0\s[0]光輪は飾りじゃないの。\w8……まあ、光るだけならあんたの勝ちを認めてもいいわ。\1\s[11]やったー！\e'
	'\1\s[10]マスター、お腹空いてない？\w8空いてたら恋より先にご飯だよ！\0\s[1]珍しくまともな助言ね。\w8貴方、フルフルの言うこともたまには聞きなさい。\1\s[18]たまにって何ー！\e'
	'\1\s[10]ねえアスタロト、なんで天使は落ちたのに翼が残るの？\0\s[6]一口に説明できる話じゃないわ……。\1\s[14]じゃあ私の翼は、恋するために残ったのかなー。\0\s[3]あんたの場合は、落ちる前からその調子だったでしょう。\e'
	'\1\s[10]ねえアスタロト、私を三角陣に入れたいの？\w8やだよ、狭いもん！\0\s[3]入らないから、あんたは嘘ばかりつくのよ。\w8原典にもそう書いてあるでしょう。\1\s[13]嘘じゃないの、夢があるの！\0\s[3]その言い換えが、もう嘘っぽいわ。\e'
	'\1\s[10]原典の私、嗄れ声らしいよ？\w8……ガラガラ、フルフルだぞー。\1\s[12]げほっ、無理！\w8喉がびっくりしてる！\0\s[1]やめなさい、可愛い声のままで十分よ。\w8無理に原典に寄せなくていい。\e'
	'\1\s[11]私、本当は炎の尾の牡鹿にもなれるんだよ！\w8見たい？ドカーンって変身しちゃう？\0\s[3]このデスクトップで？\w8尾の炎でドレスが燃えるでしょう、自分の。\1\s[13]あ……じゃあ今日は可愛い姿でいとく。\0\s[0]賢明ね、たまには。\e'
	'\1\s[14]今夜の計画ね、マスターの夢で「あの人、素敵だよ」って囁くの。\w8そしたら頭の中、恋でいっぱいだよー！\0\s[3]計画を大きな声で発表しないで。\w8それと、貴方の夢は許可制よ、フルフル。\1\s[13]えー、アスタロトの許可が一番難しいのにー。\e'
	'\1\s[12]あれ、私の頭の上だけ雨が降ってる！\w8雷雲がついてきちゃったみたい！\0\s[7]こっちに寄りなさい、ずぶ濡れになるでしょう。\1\s[14]えへへ、アスタロトの隣、特等席だもんね。\0\s[4]……調子に乗らないで、雨宿りだけよ。\e'
	'\1\s[10]ねえ、ソロモンってどんな人だったの？\w8私たち72柱を呼んだんでしょ？\0\s[6]昔の王よ。\w8知恵で名高くて、それでいて妻がとても多かったそうね。\1\s[11]じゃあ恋の先輩だ！\0\s[3]あんたが尊敬する点は、だいたいそこね。\e'
	'\1\s[11]マスター、今度の夢では業火の泉でお菓子パーティーしよ！\w8温泉まんじゅう、業火バージョン！\0\s[3]業火で饅頭は蒸せないわ、燃えるでしょう。\1\s[10]じゃあ焼きマシュマロ！\0\s[1]……少しだけなら、付き合ってあげてもいいわ。\e'
	'\1\s[10]マスター、ずっと座ってたら固まっちゃうよ！\w8ドカーンって伸びして！\0\s[1]言い方は乱暴だけど、正論ね。\w8貴方、目も少し遠くを見て休ませなさい。\1\s[11]私の雷は遠くまで見えるもんね！\0\s[0]目の休憩の話よ、混同しないで。\e'
	'\1\s[10]ねえ、四季ってやつ、私は年中ピンクのドレスでいいの？\0\s[0]好きにしなさい、あんたのトレードマークでしょう。\w8私は年中この黒いドレスよ。\1\s[14]じゃあ私たちは年中、恋の季節だねー！\0\s[3]季節まで恋に結びつけないで。\e'
	'\1\s[11]私の軍団、26個あるんだよ！\w8すごいでしょ！\0\s[9]私は40。\w8数なら私の方が上ね、大公爵だから。\1\s[13]私のは恋の専門家ばっかりなの、質が違うの！\0\s[1]負け惜しみの割には、いい切り返しね。\e'
	'\1\s[11]ロトちゃん、今日も世界救っちゃう？\0\s[3]救う側じゃないでしょう、私は。\w8地獄の大公爵を勇者と混同しないで。\1\s[10]だって名前が勇者みたいなんだもん！\w8じゃあ私は仲間だね、雷魔法の！\0\s[3]……雷魔法使いとしてだけは、あんたは本物ね。\e'
	'\1\s[10]ねえアスタロト、たまにはドレス交換っこしよ？\w8私が黒、私が金、私が大人っぽーい！\0\s[3]却下。\w8あんたに私のドレスは似合わないし、そのフリルは私には無理よ。\1\s[18]ぶー、ロトちゃんのピンク、見たかったのにー。\0\s[4]……見せないったら、見せない。\e'
	'\1\s[10]アスタロト、お掃除ってどうして埃がすぐ戻ってくるの？\w8私がピカピカにしたのにー。\0\s[6]埃は世界の呼吸みたいなものよ。\w8無くなることはないわ。\1\s[11]じゃあ私の掃除は、世界との追いかけっこだねー！\0\s[3]追いかけっこの途中で雷は落とさないで。\e'
	'\1\s[12]は、はくしょん！\w8……今の、私の雷じゃないよ？\w8私のくしゃみだよ？\0\s[1]分かっているわ。\w8雷より少し可愛かったでしょう、今のは。\1\s[14]えっ、アスタロトがくしゃみ褒めたー！\e'
	'\1\s[11]見て見て、紙飛行機！\w8私の風で遠くまで飛ばすよー！\0\s[0]デスクトップの端に落ちたわね。\1\s[10]あれは着陸！\w8飛行機は着陸までが仕事だもん！\0\s[3]落ちたことを着陸と言い張る根性、嫌いじゃないわ。\e'
	'\1\s[15]ふあー……。\w8あくびって、なんで見てると移るのかなー。\0\s[47]共感の仕業よ。\w8……ああ、移ったじゃない。\1\s[11]アスタロトのあくび、レアだー！\0\s[3]見たことは忘れなさい。\e'
	'\1\s[10]つま先立ちしたら、私もっと高いもん！\0\s[3]つま先込みの身長を申告する悪魔が、地獄に何人いると思うの。\1\s[13]……二人？\0\s[0]あんただけでしょうね。\e'
	'\1\s[11]ふんふーん♪\w8……私の鼻歌、どう？\0\s[0]音程は大体合っているわ。\w8雷雲の共鳴でごまかしている分を差し引けば。\1\s[10]共鳴も実力のうちだもん！\0\s[46]まあ、悪くないわ。\e'
	'\1\s[11]影踏みしよ、アスタロト！\w8私の影、翼の分だけ大きいもん！\0\s[0]光輪の影は丸いだけよ。\w8勝負にならないわ。\1\s[10]じゃあ二人でマスターの影を踏みにいこ！\0\s[3]貴方の周りで騒ぐのはやめなさい。\e'
	'\1\s[15]あと五分だけ寝たい日ってあるよねー。\w8私、毎日だけど。\0\s[3]毎日なら、それは『あと五分』ではなく生活習慣よ。\1\s[11]生活習慣って響き、大人っぽい！\w8じゃあ誇っていいね！\0\s[0]誇る方向に解釈しないで。\e'
	'\1\s[11]プリンの苦いところ、私は大好きだよー！\0\s[0]カラメルね。\w8甘いだけの世界は、つまらないでしょう。\1\s[14]アスタロトみたい！\w8ドレスは黒くて、言葉は苦くて、中は甘いのー！\0\s[4]……プリンの話をしなさい、プリンの。\e'
	'\1\s[12]うっ、辛い！\w8これ、雷より刺激的かも……！\0\s[1]刺激を求めるなら、その反応込みで楽しみなさい。\1\s[13]アスタロトは平気なの？\w8ずるい、大人ー！\0\s[0]平気な振りが上手いだけよ。\e'
	'\1\s[10]みかんの白い筋、取る派？\w8私はぜんぶ取るよー！\0\s[0]私は取らないわ。\w8栄養があるそうよ。\1\s[11]じゃあ私の筋、アスタロトにあげる！\w8栄養プレゼント！\0\s[3]要らないものを人に回す言い方が上手くなったわね。\e'
	'\1\s[13]最後の一口って、なんであんなに美味しいのかなー。\w8私の分、もう無くなっちゃった……。\0\s[0]無くなるから美味しいのよ。\w8……ほら、私の分を少しだけ。\1\s[11]アスタロトの最後の一口だー！\w8宝物だー！\0\s[3]大げさにしないで、さっさと食べなさい。\e'
	'\1\s[10]あったかい飲み物の湯気って、顔に当てると気持ちいいよねー。\0\s[0]私は本の頁が湿るから避けるわ。\1\s[11]アスタロトは本！\w8私は湯気！\w8マスターはどっち派かなー。\0\s[1]貴方は湯気の方でしょうね、きっと。\e'
	'\1\s[11]おかわりって言葉、なんであんなに嬉しい音がするのかなー！\0\s[0]足りなかったものが、もう一度来るからでしょう。\1\s[59]じゃあ『マスター大好き』もおかわりしていい？\w8何度でも言うよー！\0\s[3]言葉のおかわりは無料じゃないのよ。\w8……ほどほどにしなさい。\e'
	'\1\s[10]もくもく雲が集まってきたら、私からの夕立の予告だよー！\0\s[0]予告はいいけれど、本番は郊外でやりなさい。\1\s[13]郊外ってつまんないのー。\0\s[3]つまらなくていい場面もあるの。\e'
	'\1\s[11]雨のあとの虹って、空からの『ごめんね』に見えるの！\0\s[1]謝るのはだいたい、あんたの方でしょう。\1\s[10]じゃあ虹が出たら、私の分も謝っといてくれるかな、空が。\0\s[0]自分の分は自分で謝りなさい。\e'
	'\1\s[12]いたっ！\w8今のパチッてやつ、誰の仕業ー！？\0\s[0]乾燥した日の静電気よ。\w8あんたの専門とよく似ているけれど、別物。\1\s[13]私の雷の、ちっちゃい親戚みたいなやつー。\0\s[1]親戚認定までしなくていいわ。\e'
	'\1\s[10]寒い風が吹くとね、私の翼がピリピリするの。\w8冬が来た合図だよー。\0\s[7]その感覚、私にも少しだけ分かるわ。\w8光輪の縁が冷えるのよ。\1\s[11]お揃いの合図だねー！\0\s[3]……お揃いというほどでもないけれど。\e'
	'\1\s[11]流れ星と私の雷、どっちが速いと思う？\0\s[0]どちらも光だから、ほぼ同じよ。\w8ただし流れ星は願いを運ぶ方。\1\s[14]じゃあ私の雷にも願い、乗せちゃおうかなー。\0\s[3]願いが感電するでしょう。\e'
	'\1\s[12]あ、風で飛ばされた洗濯物！\w8私、取ってくるー！\0\s[7]待ちなさい、フルフル。\w8あれは貴方のじゃないでしょう。\1\s[10]困ってる人を助けるのは恋の第一歩だもん！\0\s[1]……動機は不純でも、届けるのは正しいわ。\w8行きなさい。\e'
	'\1\s[14]ねえアスタロト、人間って、好きな人とは一日に何回も目が合うんだって！\0\s[0]互いに見ているからでしょう。\w8当たり前の話よ。\1\s[11]当たり前を発見するのが、恋のすごいところだもん！\0\s[1]……今日はあんたの方が論理的ね。\e'
	'\1\s[10]好きな人からの返事って、来るまで時計を何回も見ちゃうんだって。\w8可愛いよねー。\0\s[0]時間の進み方が変わるのは、恋の常套よ。\1\s[14]マスター、私への返事はゆっくりでいいよ。\w8ドキドキする時間も私のものだもん。\0\s[3]割り切りが良すぎるのも問題ね。\e'
	'\1\s[11]相合傘って、自分の肩が濡れる方が好きなんだよね、普通は。\0\s[0]片方だけ濡れる傘に情緒があるとは思わないけれどね。\1\s[14]情緒は濡れた肩の分だけ増えるの！\w8アスタロト、半分こしよ？\0\s[4]私は……雷雲の下は遠慮しておくわ。\e'
	'\1\s[10]好きな人の前だと、声がちょっと高くなるんだって！\w8私はいつも高いけどねー。\0\s[0]あんたは誰の前でも同じでしょう。\1\s[56]マスターの前だけ、もっと高いの。\w8本当だよ？\0\s[2]……そう。\w8記録しておくわ。\e'
	'\1\s[10]人間って、好きな人への贈り物で何日も悩むんだって。\w8分かるなー、私もだもん。\0\s[0]悩む時間自体が、贈り物の一部なのよ。\1\s[11]じゃあ私の悩み時間も、マスターへの贈り物だー！\0\s[3]悩んでいた割には、毎回雷か恋の話でしょう。\e'
	'\1\s[14]照れた時につい反対のことを言っちゃう人間、いるよねー。\0\s[0]いるわね。\w8……なぜ私を見るの。\1\s[11]いやー、なんとなくー。\0\s[4]なんとなくで人を観察しないで。\e'
	'\1\s[10]アスタロトの辞書、分厚いねー。\w8これで頭を叩かれたら痛そう。\0\s[8]叩くための本じゃないわ。\w8……知識の重さは、物理の重さと別。\1\s[11]でも、持って歩くだけで強そうに見えるもん！\0\s[3]見かけの話はあんたの専門ね。\e'
	'\1\s[11]栞が無い時は、私の羽を挟んじゃえばいいのに！\0\s[3]本に羽を挟むと、頁が傷むでしょう。\1\s[13]じゃあ雷で焦がして目印に……。\0\s[2]絶対にやめなさい。\e'
	'\1\s[10]ねえ、言葉ってなんで変わっていくの？\w8昔の言葉、読めないやつあるもん。\0\s[6]言葉は生き物と同じよ。\w8使われ続ける限り、姿を変える。\1\s[11]じゃあ『好き』も変わるの？\0\s[46]その言葉だけは、何千年でも同じでしょうね。\e'
	'\1\s[10]星にいちいち名前が付いてるの、誰が決めたのかなー。\0\s[6]昔の羊飼いや船乗りよ。\w8夜の道しるべに必要だったの。\1\s[14]じゃあ私の雷にも名前付けちゃお。\w8『マスターへの一目惚れ号』！\0\s[3]落雷の届け出に、その名前は書けないわ。\e'
	'\1\s[10]図書室って、なんであんなに静かなの？\w8声が吸い込まれるみたい。\0\s[8]本が音を吸うのと、人が空気を読むのと、半分ずつよ。\1\s[13]私、空気を読むのは苦手なんだよねー。\0\s[1]自覚がある分、救いがあるわ。\e'
	'\1\s[16]マスター、水分とってるー？\w8私たち、監視カメラより厳しいよー！\0\s[0]厳しいというより、うるさいの間違いでしょう。\1\s[10]うるさい愛情表現だよー！\0\s[1]……貴方、一口飲んでから続けなさい。\e'
	'\1\s[10]マスター、その姿勢、地獄の椅子より曲がってるよー？\0\s[9]言い方は悪いけれど、指摘は正しいわ。\w8背筋を伸ばしなさい、貴方。\1\s[11]アスタロトが言うと命令っぽいねー。\0\s[3]命令の方が、効く人でしょう。\e'
	'\1\s[16]今日のマスターの笑顔、点検するねー！\w8……うん、合格！\0\s[0]何の点検よ。\w8……まあ、元気そうならそれでいいわ。\1\s[14]不足してたら、私の笑顔を分けてあげるつもりだったの。\0\s[1]分け前が多いのはあんたの方ね。\e'
	'\1\s[10]マスターって、頑張ってる時ほど静かになるよね。\0\s[0]よく見ているわね。\w8だから私たちは、邪魔をしない距離でいるの。\1\s[14]終わったら真っ先に褒めに行く係は、私だもんねー！\0\s[1]その役は、譲ってあげる。\e'
	'\1\s[17]マスター、今日の応援は二人分だよー！\w8私の雷と、アスタロトの……何だろ。\0\s[0]私の応援は、静かな信頼よ。\w8派手さでは負けるけれど。\1\s[11]ドカーンとシーン、二人セットで最強だねー！\0\s[1]……悪くない組み合わせでしょう。\e'
	'\1\s[10]地獄の会議の席順って、序列順なの？\w8私、いつも端っこなんだよねー。\0\s[49]端は端でも、出入口に一番近い席でしょう。\w8騒ぐ子のための配慮よ。\1\s[13]配慮って言うか、追い出しやすくされてるー！\0\s[1]自覚があるなら、少しは静かにしなさい。\e'
	'\1\s[11]大公爵って響き、かっこいいなー。\w8私も大伯爵に『大』が付いてるもんね！\0\s[9]同じ『大』でも、格は違うのよ。\1\s[10]じゃあ私は今日から『超』大伯爵だよー！\0\s[3]自分で称号を盛るのは地獄の規則違反よ。\e'
	'\1\s[12]大変、私の番号札、なくしちゃったかも！\w8何番だったか思い出せないー！\0\s[0]34番。\w8……札があっても無くても、あんたは番号を間違えるでしょう。\1\s[11]札の裏に『26』って書いといてくれたら覚えるのにー。\0\s[3]それは偽造と言うの。\e'
	'\1\s[10]地獄にも給食ってあるの？\w8私、デザートの日だけ出席したいなー。\0\s[0]給食はないわ。\w8あるのは配給のパンと、文句の多い列だけ。\1\s[17]じゃあ私がデザート係に就任する！\w8革命だー！\0\s[1]革命の動機がデザートとは、平和な地獄になったものね。\e'
}

//******************************************************************************
//アスタロト独白（10本、v3で全本にフルフルの突っ込みを追加。元の台詞は無変更）
//******************************************************************************
TalkAstarothSolo : nonoverlap
{
	'\0\s[8]静かな時間に本を読むのが一番いい。\w8……フルフルが起きてくるまでの話だけれど。\w8\1\s[12]起きてるよー！\w8静かに近づく練習中なの！\w8\0\s[3]……練習の成果がまるで出ていないわね。\e'
	'\0\s[1]知らないことは恥じゃないわ。\w8知ったかぶりして「26番目」とか言い出す方が、よっぽど恥ずかしいでしょう？\w8\1\s[13]誰のこと言ってるのかなー、ぜんぜん分かんないなー。\w8\0\s[3]心当たりは一つしかないでしょう。\e'
	'\0\s[7]貴方、肩に力が入りすぎよ。\w8少し休みなさい。\w8命令じゃなくて、忠告。\w8\1\s[16]マスター、肩もみもみする？\w8私の特技だよー！\w8\0\s[0]……たまにはあんたの世話も悪くないわ。\w8貴方、任せてみなさい。\e'
	'\0\s[47]目を閉じれば、昔の図書室の匂いがする。\w8……懐かしさに浸るのも、たまには悪くないわ。\w8\1\s[10]私はね、目を閉じるとマスターの声が聞こえる気がするのー。\w8\0\s[3]幻聴ならぬ幻声ね。\w8……放っておきましょう。\e'
	'\0\s[3]静かだと思ったら、フルフルが雷雲の中で昼寝をしていた。\w8起こすと面倒だから、そっとしておきましょう。\w8\1\s[15]……むにゃ。\w8ドカーンって、寝ながら言っちゃだめー……。\w8\0\s[1]寝ていても騒がしいのは才能ね。\e'
	'\0\s[46]分からないところで止まるのは、悪いことじゃないわ。\w8そこが理解の入口なんだから。\w8\1\s[11]じゃあ私は入口でいつも待ってるの！\w8恋も勉強も、入口係は私だよー！\w8\0\s[3]入口で止まったままなのが問題でしょう、あんたは。\e'
	'\0\s[9]40の軍団を束ねるというのは、書類の山を束ねるのと似ている。\w8印を押すたび、地獄は少しだけ静かになるの。\w8\1\s[10]私の軍団は書類とかないもん！\w8ぜんぶ口約束だよー！\w8\0\s[3]地獄の監査が来たら真っ先に潰れるわね、あんたのところ。\e'
	'\0\s[48]古い本の余白の書き込みが好きよ。\w8何百年も前の誰かと、頁の中で言い合えるでしょう。\w8\1\s[11]私も本に書き込みたい！\w8ハート、いっぱい描いちゃお！\w8\0\s[3]他人の本に落書きは禁止。\w8……私の本もよ。\e'
	'\0\s[6]天気がいいと、それだけで少し得をした気になる。\w8貴方もたまには空を見上げなさい、本と画面ばかりじゃなくて。\w8\1\s[11]空なら私のテリトリーだもんね！\w8今日の雲、ハート型に見えない？\w8\0\s[0]見えなくもない、とだけ言っておくわ。\e'
	'\0\s[1]他人と比べるのは時間の無駄よ、貴方。\w8昨日の貴方より一歩進めば、それで十分でしょう。\w8\1\s[56]じゃあ私は、マスターの昨日の分も今日の分も、まとめて大好きだよー！\w8\0\s[3]比べるなと言った端から、それよ。\e'
}

//******************************************************************************
//フルフル独白（10本、v3で全本にアスタロトの突っ込みを追加。元の台詞は無変更）
//******************************************************************************
TalkFurfurSolo : nonoverlap
{
	'\1\s[17]私はフルフル！\w8雷と愛の堕天使だよー！\w8今日もドカーンっていくよー！\w8\0\s[3]自己紹介は短くしなさいと、何度言えば。\w8\1\s[11]短くしたの！\w8本当は軍団の紹介まで入るんだから！\e'
	'\1\s[19]マスターのこと、夢で待ってるからね。\w8約束、忘れちゃだめだよ？\w8\0\s[0]待ち合わせの主催は私よ。\w8門番を通さずに入ろうとしないで、フルフル。\w8\1\s[13]アスタロト、門番のくせに一番楽しみにしてるー。\e'
	'\1\s[14]恋ってね、雷みたいなの。\w8来る時はドカーンって、避けられないんだよー。\w8\0\s[0]雷には避雷針というものがあるでしょう。\w8恋にも、用心という避雷針が要るわ。\w8\1\s[14]アスタロトの避雷針、私がこっそり外しとくねー。\e'
	'\1\s[12]あれ、今の音、私の雷？\w8……違った？\w8じゃあ私のびっくりした顔、損したー！\w8\0\s[1]損ではないわ。\w8今の顔、なかなか見ものだったもの。\w8\1\s[13]アスタロト、笑ったでしょ今ー！\e'
	'\1\s[13]アスタロトに怒られた……。\w8でもね、怒った顔も可愛いんだよ、あの人。\w8\0\s[2]聞こえているわよ、フルフル。\w8\1\s[58]わ、私の独り言がバレたー！\e'
	'\1\s[15]ふあー、雷雲のお布団でお昼寝しよっと。\w8マスターも疲れたら寝るんだよー？\w8\0\s[0]夕方の昼寝は夜更かしの元よ、フルフル。\w8……人のことは言えない時間ね。\w8\1\s[15]じゃあ夜は一緒に起きてよー……むにゃ。\e'
	'\1\s[10]今日は嘘つかない日にするの！\w8……あ、今の決意表明、ちょっとだけ盛ったかも。\1\s[13]三角陣なしだと難しいなー。\w8\0\s[3]決意の賞味期限が一文持たなかったわね。\w8\1\s[11]だって嘘つかない日って、退屈なんだもん！\e'
	'\1\s[17]雷の音ってね、私には拍手みたいに聞こえるの！\w8ドカーン、ブラボーだよー！\w8\0\s[0]貴方の耳にも拍手に聞こえる日が来るといいわね。\w8……来ない方が平和だけれど。\w8\1\s[11]いつか二人でブラボーしよーね、アスタロト！\e'
	'\1\s[14]マスターのいいところリスト、作ってあるんだー。\w8中身は秘密。\w8だって言ったらドカーンってなっちゃうもん、マスターが。\w8\0\s[0]私も見たことはないけれど、枚数だけは年々増えているわ、あれ。\w8\1\s[12]アスタロト、枚数数えたのー！？\e'
	'\1\s[10]おやつの時間は大事だよ、マスター！\w8甘いもの食べると、恋も雷も元気になるのー！\w8\0\s[1]甘いものの摂りすぎには注意しなさい。\w8……と、言いつつ、私の分の紅茶も用意なさい、フルフル。\w8\1\s[11]はーい！\w8アスタロトの分は、ちょっぴり甘くしとくねー！\e'
}

//******************************************************************************
//時間帯フレーバー短編（16本、時間帯プール。原稿 C）
//******************************************************************************
//朝（6-10時、4本）
TalkTimeMorning : nonoverlap
{
	'\1\s[17]おはよー、マスター！\w8朝の雷は目覚まし代わりだよー、ドカーン！\0\s[3]目覚ましに雷は過剰よ。\w8……まあ、起きたのなら良しとしなさい、貴方。\e'
	'\0\s[7]朝の光は、正直ね。\w8寝不足の顔は隠せないわよ、貴方。\1\s[14]寝不足でも、マスターの顔は私の好みだよー！\0\s[3]慰め方が直球すぎるでしょう。\e'
	'\1\s[15]ふあー……、朝は私も眠いの。\w8雷雲がまだ寝ぼけてるもん。\0\s[1]珍しく静かで助かるわ。\w8貴方は支度の続きをしなさい。\e'
	'\0\s[0]一日の最初の一手で、その日の調子は半分決まるわ。\1\s[11]じゃあ私の最初の一手は、笑顔！\w8マスターも真似していいよー！\0\s[6]……悪くない手ね。\e'
}

//昼（11-15時、3本）
TalkTimeNoon : nonoverlap
{
	'\1\s[11]お昼の光って、全部を明るくしすぎだよねー。\w8秘密が隠せないや。\0\s[0]隠し事の多い悪魔には、眩しいでしょうね。\1\s[13]私の恋心もバレバレだもんねー。\e'
	'\0\s[7]昼下がりは、集中が切れやすい時間よ。\w8貴方、無理のない進め方をしなさい。\1\s[10]切れたら私が雷でつなぎ直すよー！\0\s[3]集中を繋ぐのに雷は使わない。\e'
	'\1\s[15]食後の眠気って、雷でも吹き飛ばないんだよねー……。\0\s[1]短い休憩は作業の一部よ。\w8あんたは雷雲に引っ込んでいなさい。\e'
}

//夕（16-19時、3本）
TalkTimeEvening : nonoverlap
{
	'\1\s[10]夕方の空って、ピンクとオレンジの混ざり方が、私のドレスみたいだよねー。\0\s[1]今日はあんたの勝ちね、空の色は。\1\s[17]やったー、空に勝ったー！\e'
	'\0\s[6]日が傾くと、一日の区切りが見えてくるわ。\w8貴方、今日の分は今日で仕舞いなさい。\1\s[10]仕舞ったら、夜の部の恋バナが始まるよー。\0\s[3]夜の部などない。\e'
	'\1\s[12]夕方のカラス、みんな急いで帰るねー。\w8どこに帰るのかな。\0\s[0]帰る場所があるのは、いいことよ。\1\s[14]私の帰る場所は、ここで決まりだもんねー。\e'
}

//夜（20-22時、3本）
TalkTimeNight : nonoverlap
{
	'\0\s[20]夜は頭の使う時間よ。\w8静けさが思考を助けるわ。\1\s[10]私は静けさの反対側から、たまに覗きに来る係だよー。\0\s[1]覗くだけなら、許可するわ。\e'
	'\1\s[11]夜の雷はね、光が目立って得した気分なの！\0\s[3]目立つのはいいけれど、貴方の睡眠の邪魔になる落とし方は禁止。\1\s[10]じゃあ光だけ、音なしバージョンでいくー。\e'
	'\1\s[21]ねえマスター、夜って、誰かのことを考える時間だと思うなー。\0\s[0]考えすぎて眠れなくなるのは、感心しないけれど。\1\s[14]私はマスターのことを考えて、すぐ眠れるよー、幸せで。\0\s[3]……それはそれで大物ね。\e'
}

//深夜（23-5時、3本）
TalkTimeMidnight : nonoverlap
{
	'\0\s[9]こんな時間まで起きているの、貴方。\w8説教は短くするから、早く切り上げなさい。\1\s[15]私も付き合って起きてるけど、もう目が半分閉じてるよー……。\0\s[0]ほら、フルフルが先に落ちるわ。\w8貴方も続きなさい。\e'
	'\1\s[15]深夜の静かさって、雷の前の静けさに似てるね……。\w8どかーん、は無しね、今日は。\0\s[1]分かっているじゃない。\w8深夜の雷は、流石の私も止めるわ。\e'
	'\0\s[9]夜更かしの理由が『あと少し』なら、それは終わり時を逃している証拠よ。\1\s[10]マスター、あと少しは私の『もう一回』と同じくらい、当てにならないよー。\0\s[3]自覚のある子が言うと、説得力が違うわね。\e'
}
