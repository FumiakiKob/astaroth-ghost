//******************************************************************************
// アスタロト＋フルフル 不在看板辞書 v2（2026-11-03、シェル拡充バッチ3／
// 2026-11-05 v2.19 で看板30の表示を概念に合わせて修正）
// 設計: SHELL_EXPANSION.md §3／GHOST_RESEARCH.md §6.4
//
// 看板は「マスター（貴方）の状態」を示す：
//   26=入浴中／27=外出中／28=勉強中／29=就寝中／30=外出中（フルフルが留守番）
// 表示はアスタロト側スコープ（\0）を看板 surface に切り替え、
// フルフル側（\1）は非表示にする。ただし30だけは例外で、留守番役の
// フルフルを通常の立ち絵（surface17）のまま画面に残す。
//（v1 では30も一律で相方を消し、呟きもアスタロトの語りになっていて
//  「フルフルが残って留守番する」という概念と食い違っていた。v2.19 で
//   立て替え・再適用・呟き・復帰トークを概念に合わせて揃えた。）
//
// 状態管理:
//   グローバル変数 astaroth_signboard に現在の看板番号（26〜30）を持つ。
//   未設定・0 は「看板なし」。YAYA のグローバル変数は保存されるため、
//   SSP を終了しても状態は残る（復帰時の吸収は SignboardBootCheck）。
//   ・立てる: SSTP NOTIFY の OnAstarothSignboard（Reference0=番号）
//            送信スクリプトは WSL の ~/sstp_signboard.py。
//            systemd timer から 23:00 に 26（入浴）、23:25 に 29（就寝）
//            を自動で送る（PC がスリープ中は発火しない＝次回起動で吸収）。
//   ・しまう: 同イベントに Reference0=0。または次回 OnBoot で
//            SignboardBootCheck が復帰トークとして吸収する。
//   ・再適用: OnSurfaceRestore で看板中なら看板表示を黙って再適用する
//            （他イベントの surface 復帰で看板が外れるのを防ぐ。
//             S the Skeleton の就寝モード再適用と同型）。
//   ・ランダムトーク: 看板中は astaroth_talk.dic の RandomTalk 入口で
//            SignboardMutter（看板越しの短い呟き）に差し替える。
//
// 規律（v2.10 の教訓）: 関数呼び出しの結果は必ず代入文で受ける。
// 裸の関数呼び出し文は書かない。
//******************************************************************************

//******************************************************************************
// SSTP からの立て替えフック OnAstarothSignboard
// Reference0: 26〜30=その看板を立てる／0=しまう／それ以外=無視
//******************************************************************************
OnAstarothSignboard
{
	_n = TOINT(reference[0])
	_script = ''
	if _n >= 26 && _n <= 30 {
		_script = SignboardSet(_n)
	}
	elseif _n == 0 {
		_script = SignboardClear
	}
	_script
}

//******************************************************************************
//看板を立てる（状態を記録し、立て替えの一言→看板表示の順で返す）
// _argv[0] : 看板番号（26〜30）
//******************************************************************************
SignboardSet
{
	astaroth_signboard = TOINT(_argv[0])
	_script = ''
	if astaroth_signboard == 26 {
		_script = '\0\s[3]貴方、お風呂でしょう。\w8留守番は看板と私たちに任せなさい。\1\s[11]いってらっしゃーい！\w8覗いたらドカーンだよー！\0\s[26]\1\s[-1]\e'
	}
	elseif astaroth_signboard == 27 {
		_script = '\0\s[0]行ってらっしゃい、貴方。\w8戸締まりは、私が確認済みよ。\1\s[11]お土産、待ってるねー！\0\s[27]\1\s[-1]\e'
	}
	elseif astaroth_signboard == 28 {
		_script = '\0\s[9]勉強に集中しなさい、貴方。\w8邪魔が入らないよう、見張っておくわ。\1\s[14]フルフル、静かにしててあげるねー……小声で。\0\s[28]\1\s[-1]\e'
	}
	elseif astaroth_signboard == 29 {
		_script = '\0\s[5]おやすみなさい、貴方。\w8明日の朝は、私が起こしてあげる。\1\s[15]ねんね中ー。\w8いい夢、届けてあげるね。\0\s[29]\1\s[-1]\e'
	}
	elseif astaroth_signboard == 30 {
		_script = '\1\s[17]フルフルのお留守番、はじまりだよー！\w8マスター、早く帰ってきてねー！\0\s[1]……任せたわ。騒ぎすぎないでちょうだい。\0\s[30]\1\s[17]\e'
	}
	_script
}

//******************************************************************************
//看板をしまう（状態を消し、種別ごとの復帰トークを返す。看板が無いときは無言）
//******************************************************************************
SignboardClear
{
	_n = 0
	if ISVAR('astaroth_signboard') {
		_n = TOINT(astaroth_signboard)
	}
	_script = ''
	if _n >= 26 && _n <= 30 {
		astaroth_signboard = 0
		_script = SignboardReturnTalk(_n)
		//姿を現す場面なので、シェルを時刻に合わせて前置する
		//（astaroth_shell.dic。朝の自動解除で通常シェルへ戻るのもこの経路）。
		_tag = ShellSyncTag(0)
		_script = _tag + _script
	}
	_script
}

//******************************************************************************
//起動時の吸収（OnBoot から呼ばれる）
// 看板状態が残っていたら、状態を消して復帰トークを返す。
// 看板が無ければ空を返し、OnBoot は通常の起動トークに進む。
//******************************************************************************
SignboardBootCheck
{
	_n = 0
	if ISVAR('astaroth_signboard') {
		_n = TOINT(astaroth_signboard)
	}
	_script = ''
	if _n >= 26 && _n <= 30 {
		astaroth_signboard = 0
		_script = SignboardReturnTalk(_n)
	}
	_script
}

//******************************************************************************
//復帰トーク（看板種別ごと。しまう操作と起動時吸収で共用）
// _argv[0] : 看板番号（26〜30）
//******************************************************************************
SignboardReturnTalk
{
	_n = TOINT(_argv[0])
	_script = ''
	if _n == 26 {
		_script = '\0\s[1]お風呂は済んだみたいね。\w8……さっぱりした顔をしているわ。\1\s[11]おかえりー！\w8いいお湯だった？\e'
	}
	elseif _n == 27 {
		_script = '\0\s[1]おかえりなさい、貴方。\w8留守の間は静かだったわよ。\1\s[11]マスター、おかえりー！\w8お土産はー？\e'
	}
	elseif _n == 28 {
		_script = '\0\s[0]勉強は終わり？\w8……お疲れさま、貴方。\1\s[11]がんばったねー！\w8えらい、えらい！\e'
	}
	elseif _n == 29 {
		_script = '\0\s[1]おはよう、貴方。\w8よく眠れた？\1\s[11]おはよー、マスター！\w8朝だよ、朝ー！\e'
	}
	elseif _n == 30 {
		_script = '\1\s[17]マスター、帰ってきたー！\w8お留守番、ちゃんとできたよ！\0\s[1]……ええ、いい子で待てていたみたいね。ご苦労さま、フルフル。\e'
	}
	_script
}

//******************************************************************************
//看板中の呟き（RandomTalk の入口から呼ばれる）
// 現在の看板種別に対応するプールへ振り分ける。
// 看板が無いときは空を返す（通常は呼ばれない）。
//******************************************************************************
SignboardMutter
{
	_n = 0
	if ISVAR('astaroth_signboard') {
		_n = TOINT(astaroth_signboard)
	}
	_script = ''
	if _n == 26 {
		_script = SignboardMutter26
	}
	elseif _n == 27 {
		_script = SignboardMutter27
	}
	elseif _n == 28 {
		_script = SignboardMutter28
	}
	elseif _n == 29 {
		_script = SignboardMutter29
	}
	elseif _n == 30 {
		_script = SignboardMutter30
	}
	_script
}

SignboardMutter26 : nonoverlap
{
	'\0\s[26]（……静かね。いい湯加減だといいけれど）\e'
	'\0\s[26]（看板は倒れていないわね。……よし）\e'
}

SignboardMutter27 : nonoverlap
{
	'\0\s[27]（留守の家は静かね。本でも読んで待つわ）\e'
	'\0\s[27]（……そろそろ、帰ってくる頃かしら）\e'
}

SignboardMutter28 : nonoverlap
{
	'\0\s[28]（邪魔はしていないわよ。……集中、続いているみたい）\e'
	'\0\s[28]（静かに見守るのも、私の務め）\e'
}

SignboardMutter29 : nonoverlap
{
	'\0\s[29]（……寝息が聞こえる。いい夢を、貴方）\e'
	'\0\s[29]（夜の見張りは私が引き受けたわ。安心して眠りなさい）\e'
}

SignboardMutter30 : nonoverlap
{
	'\0\s[30]\1\s[11]お留守番はバッチリだよー！マスターのお家は、フルフルが守るんだから！\e'
	'\0\s[30]\1\s[14]まだかなぁ、まだかなぁ……。帰ってきたら、真っ先に飛んでいくんだからね。\e'
}

//******************************************************************************
// surface 復帰時の再適用 OnSurfaceRestore
// 看板中なら、看板表示を黙って再適用する。26〜29 は看板 surface と
// フルフル非表示、30 は看板 surface と留守番中のフルフル（surface17）
// の2サーフェスで再適用する。
// 看板が無いときは何も返さない。
//******************************************************************************
OnSurfaceRestore
{
	_script = ''
	if ISVAR('astaroth_signboard') {
		if TOINT(astaroth_signboard) == 30 {
			_script = '\0\s[30]\1\s[17]\e'
		}
		elseif TOINT(astaroth_signboard) >= 26 && TOINT(astaroth_signboard) <= 29 {
			_script = '\0\s[' + TOSTR(TOINT(astaroth_signboard)) + ']\1\s[-1]\e'
		}
	}
	_script
}
