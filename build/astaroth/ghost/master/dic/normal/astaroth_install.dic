//******************************************************************************
// インストール／ドロップ時の台詞（2026-11-03、原稿 TALKS_INSTALL.md 実装）
// nar や URL をドラッグ＆ドロップで入れる場面の反応。音声は付けない。
//
// 仕様（UKADOC「SHIORIイベントリスト」で裏取り済み。原稿の実装メモ参照）:
//   OnInstallBegin     : 開始時。Reference の定義がなく種別・名前は不明 → 汎用台詞のみ
//   OnURLDropping      : URL 経由のダウンロード開始前（種別はまだ不明）
//   OnURLDropped       : ダウンロード完了・インストール直前 → 無言（直後に Begin が来る）
//   OnURLDropFailure   : ダウンロード失敗（OnInstallFailure では来ない）
//   OnInstallCompleteEx: 完了。Ref0=識別子 / Ref1=名前 / Ref2=場所。
//                        複数件は各 Reference 内でバイト値1区切り。
//                        定義がある場合は旧 OnInstallComplete の代わりにこちらが発生。
//   OnInstallComplete  : 旧仕様。Ex と同じ処理に委譲（保険）。
//   OnInstallCompleteAll: 複数 nar の総括（最後に発生。SSP 2.9.00 未満では発生しない）
//   OnInstallFailure   : Ref0=失敗理由（extraction / invalid type / artificial /
//                        unsupported / password / unlha32）
//   OnInstallRefuse    : ファイルが他ゴーストを指名していた（自ゴーストには入らない）
//   OnInstallReroute   : 指名先が起動中。以後のイベントは指名先側へ移る → 無言
//   OnFileDrop2        : インストール対象でないファイルのドロップ。
//                        応答すると本体の既定処理（ビューア等）が止まるため、
//                        台詞の末尾で \![execute,dropdefault,file,Ref0] を実行して
//                        既定処理も併せて行う（UKADOC のタグ仕様で裏取り済み:
//                        Reference0 をそのまま渡してよい）。
//
// 頻度設計（原稿メモ）: 1回の D&D で Begin → CompleteEx →（複数なら All）と
//   最大3段。開始は短く、完了時に本命を置く。複数同時の CompleteEx では
//   短い一言に留め、総括（2-6）は CompleteAll に任せて二重に長くしない。
//   ※その短い一言は原稿に無いため実装時に足した橋渡し台詞（INCompleteMain 内）。
// ネットワーク更新の報告（astaroth_update.dic）とはイベント系統が別で競合しない。
//******************************************************************************

//******************************************************************************
//1-A. インストール開始時（ローカル nar、汎用2本）
//******************************************************************************
OnInstallBegin
{
	INBeginTalk
}

INBeginTalk : nonoverlap
{
	'\0\s[2]あら、貴方。\w8また何か拾ってきたわね。\1\s[11]新しいお友達？\w8それともお洋服？\w8開けるの楽しみー！\0\s[0]開けてからのお楽しみ、ということにしておきなさい。\e'
	'\1\s[12]マスター、それなあに？\w8私へのプレゼント？\0\s[3]あんた宛じゃないでしょう、たぶん。\w8……たぶん、ね。\1\s[11]『たぶん』の余地があるなら、期待しちゃうー！\e'
}

//******************************************************************************
//1-B. URL 経由の開始（OnURLDropping、汎用2本）
//******************************************************************************
OnURLDropping
{
	INURLBeginTalk
}

INURLBeginTalk : nonoverlap
{
	'\0\s[0]リンクから直接お迎えとは、ずいぶん熱心ね、貴方。\1\s[11]向こうから飛んで来てくれるの？\w8お手紙みたいー！\e'
	'\1\s[10]ねえねえ、それ、空から落ちてくるの？\w8雷みたいにドカーンって？\0\s[3]落ちてくる、じゃなくて、ダウンロードと言うの。\w8……静かに見てなさい、もうすぐ着くわ。\e'
}

//******************************************************************************
//URL のダウンロード完了（インストール直前）。直後に OnInstallBegin が来るので無言
//******************************************************************************
OnURLDropped
{
	''
}

//******************************************************************************
//3-3. ダウンロード失敗（OnURLDropFailure）
//******************************************************************************
OnURLDropFailure
{
	'\0\s[0]リンクの先から、届かなかったそうよ。\1\s[13]お手紙、途中で落ちちゃったんだ……。\0\s[0]向こうの都合か、道が混んでいたのか。\w8間を置いて、もう一度試しなさい、貴方。\e'
}

//******************************************************************************
//2. インストール完了（OnInstallCompleteEx ／ 旧 OnInstallComplete も同処理）
// Reference0（識別子、複数件はバイト値1区切り）を分割して INCompleteMain へ。
//******************************************************************************
OnInstallCompleteEx
{
	INCompleteMain(SPLIT(reference[0], C_BYTE1))
}

OnInstallComplete
{
	INCompleteMain(SPLIT(reference[0], C_BYTE1))
}

INCompleteMain
{
	_types = _argv[0]
	_s = ''
	if ARRAYSIZE(_types) >= 2 {
		//複数同時: ここでは短い一言に留め、総括は OnInstallCompleteAll に任せる。
		//（この橋渡し台詞のみ原稿外の実装時追加。原稿メモの頻度設計に基づく）
		_s = '\0\s[0]色々と入り終わったみたいね。\w8……中身の確認は、後でしなさい。\e'
	}
	elseif ARRAYSIZE(_types) == 1 {
		_t = _types[0]
		if _t == 'ghost' {
			_s = INCompleteGhost
		}
		elseif _t == 'shell' {
			_s = INCompleteShell
		}
		elseif _t == 'balloon' {
			_s = INCompleteBalloon
		}
		elseif _t == 'plugin' {
			_s = INCompletePlugin
		}
		else {
			_s = INCompleteOther
		}
	}
	_s
}

//2-1. ゴースト
INCompleteGhost
{
	'\0\s[1]入り終わったわ。\w8新しい仲間ね。\1\s[11]やっほー！\w8私はフルフル、雷と愛の堕天使だよー！\0\s[0]挨拶はそのくらいに。\w8……貴方も、よろしくしてあげなさい。\e'
}

//2-2. シェル
INCompleteShell
{
	'\1\s[11]わあ、新しいお洋服！？\w8誰の？\w8私のもある？\0\s[0]シェルよ、シェル。\w8誰が着るかは、これから選ぶもの。\1\s[14]ロトちゃんの新しいドレス、楽しみにしてるねー！\0\s[3]私のとは限らないでしょう。\e'
}

//2-3. バルーン
INCompleteBalloon
{
	'\0\s[0]バルーンが増えたわ。\w8言葉の器が変わると、同じ台詞でも印象が変わるものよ。\1\s[11]じゃあ私の言葉も可愛さ倍増だねー！\0\s[3]器で倍増するなら、誰も苦労しないわ。\e'
}

//2-4. プラグイン
INCompletePlugin
{
	'\0\s[0]プラグインね。\w8目立たないけれど、縁の下の力持ちよ。\1\s[10]えんのした……？\w8じゃあ私は上でドカーンってするね！\0\s[3]役割分担が極端すぎるでしょう、あんたは。\e'
}

//2-5. その他（supplement / headline / rss / package / language 等）
INCompleteOther
{
	'\1\s[12]何か入ったー！\w8何かは分かんないけど、入ったー！\0\s[1]正直なのはいいことね。\w8……細かいものほど、大事な仕事をしていたりするのよ。\e'
}

//******************************************************************************
//2-6. 複数同時の総括（OnInstallCompleteAll）
//******************************************************************************
OnInstallCompleteAll
{
	//CompleteAll は1件だけのインストールでも発生する（実機確認済み）。
	//Reference0（バイト値1区切り）に識別子が2件以上あるときだけ総括を喋り、
	//1件のときは種別ごとの完了台詞（2-1〜2-5）で締める。
	_s = ''
	if reference[0] != '' {
		if ARRAYSIZE(SPLIT(reference[0], C_BYTE1)) >= 2 {
			_s = '\0\s[2]まとめて全部、入り終わったわ。\w8……貴方、欲張りね。\1\s[11]お友達もお洋服も一気だー！\w8宝箱みたい！\0\s[3]中身の確認もせずに騒がないで。\e'
		}
	}
	_s
}

//******************************************************************************
//3. インストール失敗（OnInstallFailure、Reference0=理由）
//******************************************************************************
OnInstallFailure
{
	_s = ''
	if reference[0] == 'artificial' {
		//3-2. ユーザーが中断
		_s = '\1\s[12]あれ、途中でやめちゃったのー？\0\s[0]気が変わるのも貴方の自由よ。\w8……気が済んだら、またどうぞ。\e'
	}
	else {
		//3-1. 解凍失敗・破損系（extraction / unsupported / invalid type / password / unlha32）
		_s = '\0\s[0]……入らなかったわ。\w8包みが途中で破れていたみたいね。\1\s[13]ドカーンってなっちゃった？\w8私の雷じゃないよ？\w8ほんとだよ？\0\s[1]分かっているわ、あんたのせいじゃない。\w8……貴方、正しい包みをもう一度持ってきなさい。\e'
	}
	_s
}

//******************************************************************************
//4-1／4-2. 他ゴースト指名（OnInstallRefuse、2本）
//******************************************************************************
OnInstallRefuse
{
	INRefuseTalk
}

INRefuseTalk : nonoverlap
{
	'\0\s[2]あら、その包み、宛名が違うわ。\w8あちらのゴースト宛よ。\1\s[10]まちがい郵便だー！\w8私が届けてあげよっか？\0\s[3]向こうが自分で受け取るでしょう。\w8……貴方も、宛先はよく見てから落としなさい。\e'
	'\1\s[13]えー、私たちのお部屋には入らないのー？\0\s[1]宛名のある物は、宛名の人の物。\w8それが地獄でもこちらの世界でも、礼儀というものよ。\e'
}

//指名先が起動中の場合、以後のイベントは指名先側へ移る。自ゴースト側は無言。
OnInstallReroute
{
	''
}

//******************************************************************************
//4-3. インストールできないファイル（OnFileDrop2）
// 台詞を返しつつ、本体の既定処理（画像ビューア等）も止めないよう、
// 末尾の \e の直前に \![execute,dropdefault,file,Reference0] を差し込む。
// Reference0 にはドロップされたパス（複数ならバイト値1区切り）が入っており、
// UKADOC のタグ仕様で「そのまま渡してよい」とされている。
//******************************************************************************
OnFileDrop2
{
	_s = INFileDropTalk
	if _s != '' {
		_s = REPLACE(_s, '\e', '\![execute,dropdefault,file,' + reference[0] + ']\e')
	}
	_s
}

INFileDropTalk : nonoverlap
{
	'\0\s[3]……貴方、それは食べられないし、着られないし、住めもしないわよ。\1\s[10]じゃあ何に使うのー？\0\s[0]使うのは貴方でしょう。\w8私たちに預ける物じゃない、ということ。\e'
	'\1\s[11]マスター、それ見せてくれるの？\0\s[1]見せるだけなら構わないわ。\w8でも、預かる場所はここじゃないわよ。\e'
}
