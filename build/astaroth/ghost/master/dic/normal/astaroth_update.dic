//******************************************************************************
// ネットワーク更新の結果報告トーク（2026-11-03）
// SSP は更新が無いとき画面で反応しないため、結果をゴーストの口から報告する。
// 仕様根拠: UKADOC「SHIORIイベントリスト」ネットワーク更新イベント
//   発生順序: OnUpdateBegin →（更新がある場合のみ）OnUpdateReady →
//             OnUpdateComplete / OnUpdateFailure
//   OnUpdateBegin    : Reference0=ゴースト名、Reference1=フルパス
//   OnUpdateComplete : Reference0=成功理由（none=更新なし / changed=更新された）
//                      Reference1=更新されたファイル名のリスト（カンマ区切り）
//   OnUpdateFailure  : Reference0=失敗理由（timeout / md5 miss / 404等の
//                      ステータスコード / artificial / fileio / readonly 等）
//                      Reference1=更新できなかったファイル名のリスト（SSP）
// 報告は結果イベント（Complete / Failure）でのみ行い、OnUpdateBegin では
// 喋らない（二重バルーン防止。localhost 配信は即時に終わるため途中経過は不要）。
// なお yaya_base 側の SHIORI3EV.OnUpdateComplete（: void、dl2 処理）は
// 本体の内部処理として先に呼ばれ、その後にこの OnUpdateComplete が呼ばれる
//（yaya_base shiori3.dic のイベントディスパッチ順による）。
//******************************************************************************

//******************************************************************************
//更新完了（更新あり／更新なしを Reference0 で判別）
//******************************************************************************
OnUpdateComplete
{
	_script = ''
	if reference[0] == 'none' {
		//更新なし（最新）
		_script = '\0\s[0]更新を確認したわ、貴方。\w8目新しいものは無かった。\w8貴方の私は、いまのところ最新のままよ。\e'
	}
	else {
		//更新あり（changed）。件数は Reference1 のファイルリストから数える
		_n = 0
		if reference[1] != '' {
			_n = ARRAYSIZE(SPLIT(reference[1], ','))
		}
		if _n > 0 {
			_script = '\0\s[1]更新が届いたわ、貴方。\w8ファイルを ' + TOSTR(_n) + ' 件、新しいものに取り替えたわ。\w8少しは退屈しのぎが増えたはずよ。\1\s[11]新しいお話、増えたー！\e'
		}
		else {
			_script = '\0\s[1]更新が届いたわ、貴方。\w8中身を新しいものに取り替えたから、少しは退屈しのぎが増えたはずよ。\1\s[11]新しいお話、増えたー！\e'
		}
	}
	_script
}

//******************************************************************************
//更新失敗（理由は Reference0。そのまま読み上げて診断の手がかりにする）
//******************************************************************************
OnUpdateFailure
{
	_script = ''
	if reference[0] == 'md5 miss' {
		_script = '\0\s[3]更新が失敗したわ、貴方。\w8届いたファイルの照合が合わなかったそうよ。\w8……置き場所の方に、ずれがあるわね。\1\s[13]ドカーンって、もう一回やれば直るかもー？\e'
	}
	elseif reference[0] == 'timeout' {
		_script = '\0\s[3]更新が失敗したわ、貴方。\w8向こうの応答が、時間内に来なかった。\w8……焦らず、間を置いてもう一度試しなさい。\1\s[13]むー、待ちぼうけは嫌いだよー。\e'
	}
	else {
		_script = '\0\s[3]更新が失敗したわ、貴方。\w8理由は「' + reference[0] + '」だそうよ。\w8……心当たりは、後で確かめましょう。\1\s[13]しっぱいしちゃったー。\w8マスター、もう一回やってみよ？\e'
	}
	_script
}

//******************************************************************************
// SSTP NOTIFY からの更新要求フック OnAstarothUpdateRequest（2026-11-03）
// 外部から SSTP SEND で直接送ったスクリプトの \![updatebymyself] は、
// SSP が 200 OK で受理するだけで実行しなかった（サーバへのアクセスも
// 発生しない）ことを実機で確認済み。そのため、NOTIFY でこのイベントを
// 起こし、辞書が返したスクリプト（＝ゴースト自身の発話）の中から更新
// タグを実行させる経路にする（OnFurfurTalkTest 等のテストフックと同型）。
// このフックは開始の一言だけを喋って \![updatebymyself] を実行し、
// 結果の報告は上記 OnUpdateComplete / OnUpdateFailure に任せる
// （OnUpdateBegin で喋らない方針とも競合しない。バルーンは順に閉じる）。
//******************************************************************************
OnAstarothUpdateRequest
{
	'\0\s[0]更新を確認するわ、貴方。\![updatebymyself]\e'
}
