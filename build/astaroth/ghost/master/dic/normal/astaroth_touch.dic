TouchNadeF3
{
	'\1\s[14]マスター……。\w8私をこんなに可愛がってくれるの、マスターだけだよ。\w8大好き、知ってる？\0\s[4]……ええ、知っているわ。\e'
	'\1\s[15]すやすや……。\w8あ、寝てないよ？\w8気持ちよくて、目が閉じちゃうだけ。\0\s[1]幸せそうで何よりよ。\e'
}

//******************************************************************************
//テスト用フック（状態の初期化／段階プリセット。無言で返す）
//******************************************************************************
OnAstarothTouchTest
{
	if reference[0] == 'pre2' {
		_d = TouchTestReset(2)
	}
	elseif reference[0] == 'pre5' {
		_d = TouchTestReset(5)
	}
	else {
		_d = TouchTestReset(0)
	}
	''
}

TouchTestReset
{
	astaroth_touch_poke0 = 0
	astaroth_touch_poke1 = 0
	astaroth_touch_nadelast0 = 0
	astaroth_touch_nadelast1 = 0
	if _argv[0] == 2 {
		astaroth_touch_nadecount0 = 2
		astaroth_touch_nadecount1 = 2
	}
	elseif _argv[0] == 5 {
		astaroth_touch_nadecount0 = 5
		astaroth_touch_nadecount1 = 5
	}
	else {
		astaroth_touch_nadecount0 = 0
		astaroth_touch_nadecount1 = 0
	}
	astaroth_touch_mv_scope = -1
	astaroth_touch_mv_dir = 0
	astaroth_touch_mv_leg = 0
	astaroth_touch_mv_rev = 0
	0
}
