//******************************************************************************
// アスタロト＋フルフル 起動・終了辞書 v2（2026-11-03）
// v1 の一人構成から二人構成へ書き換え。ランダムトーク本体は
// astaroth_talk.dic、時報は astaroth_hourly.dic を参照。
// ※フルフル側の実画像は未制作（surface10 は現在ダミー）。
//   nar の再ビルドは立ち絵完成後に行うこと。
//******************************************************************************

//******************************************************************************
//初回起動 OnFirstBoot（二人の自己紹介。26／34 の取り違えネタを使う）
//******************************************************************************
OnFirstBoot
{
	username = '貴方'
	aitalkinterval = 420
	'\0\s[0]初めまして、じゃないわね。\w8アスタロトよ。\w8今日からは連れが増えるわ。\w8自分で名乗りなさい、フルフル。\1\s[11]はーい！\w8私はフルフル！\w8ソロモン72柱の26番目で、雷と愛を司る堕天使だよー！\0\s[3]34番目。\w826はあんたの軍団数でしょう、初対面で間違えないで。\1\s[11]細かいことはドカーンと吹き飛ばそ！\w8マスター、夢で会う約束、覚えてる？\w8これからはデスクトップでも会えるよー！\0\s[1]……騒がしくなるけれど、退屈はさせないわ。\w8よろしくしなさい、貴方。\e'
}

//******************************************************************************
//通常起動 OnBoot（間隔を設定してから候補関数へ）
//******************************************************************************
OnBoot
{
	aitalkinterval = 420
	//看板状態が残っていたら復帰トークで吸収する（astaroth_signboard.dic）。
	//看板が無ければ空が返り、通常の起動トークに進む。
	_script = SignboardBootCheck
	if _script == '' {
		_script = OnBootTalk
	}
	_script
}

OnBootTalk : nonoverlap
{
	'\0\s[1]来たわね、貴方。\w8アスタロトはいつもここにいるわよ。\1\s[11]マスター、おかえりー！\w8フルフルもいるよー！\e'
	'\1\s[11]マスターだ！\w8ねえアスタロト、マスターが来たよー！\0\s[0]分かっているわ、騒がないで。\w8……よく来たわね、貴方。\e'
	'\0\s[0]あら、貴方。\w8フルフルは雷雲で昼寝中よ、今のうちに静かに過ごしましょう。\1\s[15]……むにゃ、ドカーン……。\0\s[1]寝言まで騒がしいのね、あの子は。\e'
}

//******************************************************************************
//終了 OnClose（\e は付けないこと）
//******************************************************************************
OnClose
{
	OnCloseTalk
}

OnCloseTalk : nonoverlap
{
	'\1\s[15]マスター、もうおしまい？\w8……夢で待ってるからね、約束だよー。\0\s[5]もう行くの。\w8……仕方ないわね、また呼びなさい。\w9\w9\-'
	'\0\s[5]今日はここまでね、貴方。\1\s[10]ばいばーい、マスター！\w8次は恋バナの続きしよ！\0\s[3]……静かに見送りなさい、フルフル。\w9\w9\-'
}
