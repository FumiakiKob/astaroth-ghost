}

//******************************************************************************
//周期イベント OnMinuteChange
// 正時（分==0）のときだけ AstarothHourlyTalk の結果を返す。
// それ以外の分では何も返さない（無応答）。
//******************************************************************************
OnMinuteChange
{
	if GETTIME[5] != 0 {
		return
	}
	_script = AstarothHourlyTalk(GETTIME[4])
	_script
}

//******************************************************************************
//テスト用フック OnAstarothHourlyTest
// SSTP NOTIFY で Reference0 に時（0〜23）を渡すと、
// 時刻合わせなしに即座にその時刻の時報を返す（導入直後の検証用）。
// 例：
//   NOTIFY SSTP/1.1 / Event: OnAstarothHourlyTest / Reference0: 14
//******************************************************************************
OnAstarothHourlyTest
{
	_script = AstarothHourlyTalk(TOINT(reference[0]))
	_script
}
