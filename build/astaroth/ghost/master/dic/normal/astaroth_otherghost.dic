//******************************************************************************
// 他ゴーストへの反応トーク（2026-11-03、原稿 TALKS_OTHER_GHOST.md 実装）
// 隣に他のゴーストが呼ばれたときの反応。音声は付けない（ランダムトークと同方針）。
//
// 検知方式（UKADOC「SHIORIイベントリスト」で裏取り済み。原稿の実装メモ参照）:
//   来た    : OnOtherGhostBooted  Ref0=本体側名 / Ref2=ゴースト名
//             ※このイベントは「他のゴーストが呼んだ相手の起動完了」を傍で見る
//               第三者にだけ届く。呼び出し側本人には配送されない（UKADOC 明記：
//               Booted は、呼び出し側に OnGhostCallComplete が出るのと同じ
//               タイミングで、無関係なゴーストに発生する）。
//   自分たちが呼んだ: OnGhostCalling（呼び出し指示の時点。相手は未起動のため無言）
//             → OnGhostCallComplete（相手の起動スクリプト完了後。
//               Ref2=相手のゴースト名 / Ref0=相手の本体側名で、並びは Booted と同一。
//               挨拶はここで OGReact を共用する）
//             自分のメニューから「追加で呼ぶ」をした場合はこちらで拾う（v2.8で追加。
//             v2.7 ではこのハンドラが無く、追加で呼んでも反応しなかった）。
//   替わった: OnOtherGhostChanged Ref1=切替先の本体側名 / Ref5=切替先のゴースト名
//             （Ref0 は直前の本体側名なので使わない）
//   帰った  : OnOtherGhostClosed  Ref0=本体側名 / Ref2=ゴースト名
//   消えた  : OnOtherGhostVanished Ref0=本体側名 / Ref2=ゴースト名（無言で後片付けのみ）
//   自分たちが呼ばれた: OnGhostCalled Ref0=呼び出した側の本体側名 / Ref2=ゴースト名
//             （空を返すと続けて通常の OnBoot が発生するので、抑制時は空を返す）
//   起動時点で誰かいるか: On_otherghostname（NOTIFY）で一覧を変数に保持するだけ。
//
// 名前照合: ゴースト名と本体側名（sakura.name）の両方をキーにし、どちらか一致で採用。
//   台詞への名前差し込みはしない（本体側名が型番のような相手でも破綻しないため）。
//   実物 descript.txt で確認済みのキー:
//     ．さくら        ゴースト名「．さくら」      / 本体側名「さくら」
//     S the Skeleton  ゴースト名「S the Skeleton」/ 本体側名「RYS-0825」
//     荒沢さん        ゴースト名「荒沢さん」      / 本体側名「めのう」
//   猫刻・みっしー＆まこぴー・偽春菜はキーが未確定のため、原稿の残課題に従い
//   個別反応（B2/B3）を照合に接続していない。台詞プール OGTalkNekotoke /
//   OGTalkMisshi は用意してあるので、実機の descript.txt でキーが確定したら
//   OGSpecificCode に照合行を足すだけで有効化できる。それまでは汎用反応に倒れる。
//
// 頻度抑制（原稿の案を実装）:
//   ・相手ごとの初回フラグ（astaroth_og_greeted_v2、識別名の配列）: 挨拶は相手ごとに1回だけ。
//   ・全体クールダウン（astaroth_og_lasttime_v2）: 反応後600秒（目安10分）は再反応しない。
//   ・Closed（見送り）は、挨拶済みの相手が帰るときだけ。見送ったらフラグを外し、
//     また来たときに再び挨拶できるようにする。見送りもクールダウンを更新する。
//   ・A1（初めて並んだ）は、誰に対してもまだ挨拶していない時だけ（astaroth_og_ever_v2）。
//
// 状態変数（astaroth_og_*_v2）は全てこのファイル内で管理する。
// ※v2.8 での状態リセット措置（今回限り・恒常仕様ではない）: 抑制系の変数名を
//   旧名（astaroth_og_greeted / _lasttime / _ever / _lastname）から _v2 付きに
//   改名した。合成テストでユーザー実機側に立ってしまった旧変数の抑制状態
//   （挨拶済みフラグ・クールダウン）を引き継がず、配信直後から素の状態で
//   挨拶できるようにするため。旧変数は実機側に残るが、もう参照されない。
//   次回以降の更新では変数名はこのまま使う（毎回リセットはしない）。
//******************************************************************************

//******************************************************************************
//状態管理ユーティリティ
//******************************************************************************
OGNow
{
	TOINT(GETSECCOUNT)
}

OGInCooldown
{
	_r = 0
	if ISVAR('astaroth_og_lasttime_v2') {
		_now = OGNow
		if _now - astaroth_og_lasttime_v2 < 600 {
			_r = 1
		}
	}
	_r
}

OGIsEver
{
	_r = 0
	if ISVAR('astaroth_og_ever_v2') {
		if astaroth_og_ever_v2 != 0 {
			_r = 1
		}
	}
	_r
}

OGWasGreeted
{
	_found = 0
	if ISVAR('astaroth_og_greeted_v2') {
		for _i = 0 ; _i < ARRAYSIZE(astaroth_og_greeted_v2) ; _i++ {
			if astaroth_og_greeted_v2[_i] == _argv[0] {
				_found = 1
			}
		}
	}
	_found
}

OGMarkGreeted
{
	if ISVAR('astaroth_og_greeted_v2') == 0 {
		astaroth_og_greeted_v2 = IARRAY
	}
	if OGWasGreeted(_argv[0]) == 0 {
		astaroth_og_greeted_v2 ,= _argv[0]
	}
	astaroth_og_ever_v2 = 1
	astaroth_og_lasttime_v2 = OGNow
	astaroth_og_lastname_v2 = _argv[0]
}

OGForgetGreeted
{
	if ISVAR('astaroth_og_greeted_v2') {
		_new = IARRAY
		for _i = 0 ; _i < ARRAYSIZE(astaroth_og_greeted_v2) ; _i++ {
			if astaroth_og_greeted_v2[_i] != _argv[0] {
				_new ,= astaroth_og_greeted_v2[_i]
			}
		}
		astaroth_og_greeted_v2 = _new
	}
}

//******************************************************************************
//名前照合（ゴースト名 _argv[0] / 本体側名 _argv[1] → 個別反応コード）
// 該当なしは '' を返す。猫刻・みっしー＆まこぴーはキー未確定のため未接続
//（ファイル冒頭の注記参照）。
//******************************************************************************
OGSpecificCode
{
	_code = ''
	if _argv[0] == '．さくら' || _argv[1] == 'さくら' {
		_code = 'sakura'
	}
	elseif _argv[0] == 'S the Skeleton' || _argv[1] == 'RYS-0825' {
		_code = 'skeleton'
	}
	elseif _argv[0] == '荒沢さん' || _argv[1] == 'めのう' {
		_code = 'arasawa'
	}
	_code
}

OGSpecificTalk
{
	_s = ''
	if _argv[0] == 'sakura' {
		_s = OGTalkSakura
	}
	elseif _argv[0] == 'skeleton' {
		_s = OGTalkSkeleton
	}
	elseif _argv[0] == 'arasawa' {
		_s = OGTalkArasawa
	}
	elseif _argv[0] == 'nekotoke' {
		_s = OGTalkNekotoke
	}
	elseif _argv[0] == 'misshi' {
		_s = OGTalkMisshi
	}
	_s
}

//******************************************************************************
//反応の本体（_argv[0]=場面 'booted'/'changed'/'called'、_argv[1]=ゴースト名、
// _argv[2]=本体側名）。喋らない場合は '' を返す。
// 'booted' は OnOtherGhostBooted（傍観）と OnGhostCallComplete（自分たちが
// 呼んだ場合）で共用する。どちらも「隣に新しいゴーストが来た」場面で、
// Reference の並び（ゴースト名／本体側名）も同一のため。
// 優先順位: 個別反応（B）＞ 初めて並んだ（A1）＞ 場面別の汎用（A2/A3、A5 は眺める枠）
//******************************************************************************
OGReact
{
	_kind = _argv[0]
	_id = _argv[1]
	if _id == '' {
		_id = _argv[2]
	}
	_said = ''
	if _id != '' {
		if OGWasGreeted(_id) == 0 {
			if OGInCooldown == 0 {
				_code = OGSpecificCode(_argv[1], _argv[2])
				if _code != '' {
					_said = OGSpecificTalk(_code)
				}
				elseif OGIsEver == 0 {
					_said = OGTalkA1
				}
				elseif _kind == 'changed' {
					_said = OGTalkA3
				}
				elseif _kind == 'booted' {
					if RAND(2) == 0 {
						_said = OGTalkA2
					}
					else {
						_said = OGTalkA5
					}
				}
				else {
					_said = OGTalkA2
				}
				if _said != '' {
					OGMarkGreeted(_id)
				}
			}
		}
	}
	_said
}

//******************************************************************************
//イベントハンドラ
//******************************************************************************
OnOtherGhostBooted
{
	OGReact('booted', reference[2], reference[0])
}

OnOtherGhostChanged
{
	//新しい相手は Ref5（ゴースト名）/ Ref1（本体側名）。Ref0 は前任なので使わない
	OGReact('changed', reference[5], reference[1])
}

OnOtherGhostClosed
{
	_id = reference[2]
	if _id == '' {
		_id = reference[0]
	}
	_said = ''
	if _id != '' {
		if OGWasGreeted(_id) == 1 {
			if OGInCooldown == 0 {
				_said = OGTalkA4
				if _said != '' {
					astaroth_og_lasttime_v2 = OGNow
					OGForgetGreeted(_id)
				}
			}
		}
	}
	_said
}

OnOtherGhostVanished
{
	_id = reference[2]
	if _id == '' {
		_id = reference[0]
	}
	if _id != '' {
		OGForgetGreeted(_id)
	}
	''
}

OnGhostCalled
{
	//呼ばれて並んだ場合は起動トークと競合するため、挨拶を返すときだけ喋り、
	//抑制されて空を返したときは通常の OnBoot に任せる（仕様上の発生順序）。
	//OnBoot が発生しない経路でもランダムトーク間隔が既定値に戻らないよう、
	//OnBoot と同じ間隔をここでも設定しておく。
	aitalkinterval = 420
	OGReact('called', reference[2], reference[0])
}

OnGhostCalling
{
	//自分たちが他のゴーストを呼ぶよう指示された時点（相手はまだ起動していない）。
	//Ref0=呼ぶ相手の本体側名 / Ref1=manual か automatic / Ref2=呼ぶ相手のゴースト名。
	//挨拶は相手の起動完了後（OnGhostCallComplete）に出すので、ここでは喋らない。
	//ここで喋ると相手の起動トークに先行・競合するし、呼び出しが取り消された
	//場合に挨拶だけが残ってしまうため。
	''
}

OnGhostCallComplete
{
	//自分たちが呼んだ相手が、起動スクリプトを完了した直後。
	//Ref0=呼ばれたゴーストの本体側名 / Ref1=相手の起動時スクリプト /
	//Ref2=呼ばれたゴーストの名前 / Ref7=相手のシェル名。
	//UKADOC 明記：このタイミングで呼び出し側に来るのは本イベントであり、
	//OnOtherGhostBooted は「傍にいる無関係なゴースト」へ配送される。
	//自分のメニューから「追加で呼ぶ」をした場合の反応は、ここが担う。
	//Reference の並びは Booted と同一なので、挨拶本体は OGReact('booted', …)
	//を共用し、名前照合・個別反応・頻度抑制もそのまま効く。
	OGReact('booted', reference[2], reference[0])
}

On_otherghostname
{
	//NOTIFY: 起動中の他ゴースト一覧を保持するだけ（喋らない）。
	//保持した情報は将来の OnBoot 分岐用。現時点では記録のみ。
	astaroth_og_present = reference
	''
}

//******************************************************************************
//A1. 初めて他のゴーストが並んだとき（2本）
//******************************************************************************
OGTalkA1 : nonoverlap
{
	'\1\s[12]わっ、誰か来たよ！\w8デスクトップにお客さんだー！\0\s[2]……本当ね。\w8私たち以外のゴーストが並ぶのは、初めてだわ。\1\s[11]ねえねえ、自己紹介しよ！\w8私はフルフル、雷と愛の堕天使だよー！\0\s[3]落ち着きなさい。\w8……まあ、賑やかなのは嫌いじゃないわ。\e'
	'\0\s[0]あら、隣にどなたか。\w8……貴方、こういう時はまず挨拶でしょう。\1\s[11]はーい！\w8こんにちはー！\w8私たち、地獄から来たんだよー！\0\s[3]余計なことまで言わなくていいの。\e'
}

//******************************************************************************
//A2. 相手が来たとき（汎用、3本）
//******************************************************************************
OGTalkA2 : nonoverlap
{
	'\0\s[0]あら、いらっしゃい。\w8……と言えばいいのかしら、こういう時は。\1\s[11]いらっしゃーい！\w8ここ、眺めはいいけど、雷が時々落ちるよー！\0\s[3]落とすのはあんたでしょう。\e'
	'\1\s[11]お隣さん、こんにちはー！\w8マスターのこと、よろしくねー！\0\s[1]……仲良くしなさい、フルフル。\w8貴方のデスクトップは、少し広くなったわね。\e'
	'\0\s[2]まあ、また新しい顔。\w8貴方は同業者を集めるのが趣味なの？\1\s[10]多い方が楽しいもんねー！\w8パーティーだよ、パーティー！\0\s[3]騒がしくなる一方だわ……。\e'
}

//******************************************************************************
//A3. 相手が替わったとき（2本）
//******************************************************************************
OGTalkA3 : nonoverlap
{
	'\0\s[0]隣が入れ替わったわね。\w8前の方とはまた違う空気だわ。\1\s[10]お隣さんチェンジだねー！\w8はじめましてー！\0\s[3]さっきの方への挨拶が、まだ済んでいなかったのに。\e'
	'\1\s[12]あれっ、お隣さんが別の人になってる！\w8いつの間にー！\0\s[0]貴方が雷雲で昼寝をしている間よ。\w8……新しい方、よろしくね。\e'
}

//******************************************************************************
//A4. 相手が帰ったとき（2本）
//******************************************************************************
OGTalkA4 : nonoverlap
{
	'\0\s[0]隣の方が帰ったわ。\w8……少し静かになったわね。\1\s[13]えー、もう帰っちゃったのー？\w8また遊びに来てほしいなー。\0\s[1]また来なさい、と伝えておきましょう。\w8貴方が呼べば、また来るでしょう。\e'
	'\1\s[10]お隣さん、バイバイだねー。\0\s[0]ええ。\w8……去り際くらい、静かに見送りなさい。\1\s[15]バイバーイ……。\w8ドカーンは我慢するね。\e'
}

//******************************************************************************
//A5. 二人で相手を眺める掛け合い（3本）
//******************************************************************************
OGTalkA5 : nonoverlap
{
	'\1\s[10]ねえアスタロト、お隣さん、さっきから何してるんだろー？\0\s[0]眺めるだけなら自由よ。\w8ただし、雷は落とさないで。\1\s[11]見てるだけだよー！\w8……ちょっとだけなら？\0\s[3]だめ。\e'
	'\0\s[0]お隣の方は、なかなか落ち着いた佇まいね。\1\s[13]私たちだって落ち着いてるよー！\w8……ね？\w8ね？\0\s[3]あんたが一番落ち着いていないでしょう。\e'
	'\1\s[14]お隣さんとマスター、なんかいい雰囲気じゃない？\w8恋の予感かもー！\0\s[3]何でも恋に結びつけないで。\w8……貴方も、変な期待をしないでちょうだい。\e'
}

//******************************************************************************
//B1. さくら系譜（．さくら／偽春菜）への反応（3本）
//******************************************************************************
OGTalkSakura : nonoverlap
{
	'\0\s[0]あら……さくらさん。\w8この世界の、ずっと古い先輩よ。\w8フルフル、失礼のないように。\1\s[12]せ、先輩だー！\w8はじめまして、フルフルです！\w8雷と愛の堕天使です！\0\s[1]たまには緊張するのね、あんたも。\e'
	'\1\s[10]ねえアスタロト、あの先輩ね、気に障ると燃やしちゃうって本当？\0\s[3]噂に尾ひれが付いたものでしょう。\w8……でも、あまりちょっかいは出さないことね。\1\s[12]ひえー、私の雷より怖いかもー。\e'
	'\0\s[0]うちの看板の作法は、あの系譜の倣いなの。\w826番は看板の席、という古い約束よ。\1\s[11]じゃあ私たちの看板も、由緒正しいんだねー！\w8ドカーンと立てちゃお！\0\s[3]立てるのは私よ。\w8あんたは見てなさい。\e'
}

//******************************************************************************
//B2. 猫刻への反応（2本）※照合キー未確定のため OGSpecificCode 未接続（冒頭注記参照）
//******************************************************************************
OGTalkNekotoke : nonoverlap
{
	'\0\s[0]猫刻さん。\w8うちの時報は、もともとあの方の辞書の型を参考にしたのよ。\1\s[11]時報の大先輩だねー！\w8ねえ、雷と猫と、どっちが時間を告げるのに向いてるかなー？\0\s[3]比べるものじゃないでしょう。\e'
	'\1\s[10]あの猫さん、前はここに住んでたんでしょ？\0\s[0]ええ。\w8私たちが来るより前、貴方のデスクトップの常駐だったそうよ。\1\s[11]じゃあ私は後輩だねー！\w8今度、お魚の話を聞かせてもらおっと！\0\s[3]……無事に会話が成立すればいいけれど。\e'
}

//******************************************************************************
//B3. みっしー＆まこぴーへの反応（2本）※照合キー未確定のため OGSpecificCode 未接続
//******************************************************************************
OGTalkMisshi : nonoverlap
{
	'\0\s[0]みっしーさんと、まこぴーさん。\w8貴方のデスクトップの先輩で、私たちと同じ二人組よ。\1\s[11]二人組同士だねー！\w8仲良し対決しよ、仲良し対決ー！\0\s[1]対決にしなくて結構。\w8先輩として、静かに見習いなさい。\e'
	'\1\s[10]ねえねえ、お隣の二人組さん、息ぴったりだよねー。\w8私たちも負けてないよね、ロトちゃん！\0\s[3]……ロトちゃんは今いいわ。\w8それと、張り合うものじゃないでしょう。\1\s[11]じゃあ今度、四人でお茶会しよー！\w8恋バナ大会だよー！\0\s[3]相手の都合も聞きなさい。\e'
}

//******************************************************************************
//B4. S the Skeleton への反応（3本）
//******************************************************************************
OGTalkSkeleton : nonoverlap
{
	'\1\s[12]わあー！\w8お隣さん、骨だよ、骨！\w8ぜんぶ骨だよー！\0\s[2]……本当ね。\w8骸骨の方とお会いするのは、初めてだわ。\1\s[10]ねえ、雷が落ちたらどうなるの？\w8バラバラになっちゃう？\0\s[3]失礼なことを聞かないで。\w8……でも、少し気になるわね。\e'
	'\0\s[0]あの方の本体名、『RYS-0825』と出るのね。\w8名前というより、型番だわ。\1\s[12]あーるわいえす……読めないよー！\w8番号で呼ばれるの、軍団みたいだね！\0\s[1]地獄の軍団にも名簿の番号はあるけれど、表に出すものじゃないわね、普通。\e'
	'\0\s[0]お隣の骸骨さん、本を読んでいらっしゃるわ。\w8……頁をめくる手つきだけは、確かなものね。\1\s[11]本好き同士だね、ロトちゃんと！\w8今度おすすめ、聞いてみよー！\0\s[3]……悪い気はしないわ。\w8でも、ロトちゃんはやめなさい。\e'
}

//******************************************************************************
//B5. 荒沢さんへの反応（2本）
//******************************************************************************
OGTalkArasawa : nonoverlap
{
	'\1\s[12]ねえアスタロト、お隣さん、顔が変わったよ！？\w8さっきと違う顔してるよー！\0\s[2]……本当ね。\w8数えるのも大変なくらい、表情をお持ちのようだわ。\1\s[10]ずるいー！\w8私も顔、いっぱい欲しいー！\0\s[3]あんたは一つの顔で、十分騒がしいでしょう。\e'
	'\0\s[0]荒沢さん。\w8本体のお名前は『めのう』さんと言うのね。\w8石の名前だわ。\1\s[11]めのうって、キラキラの石だよね！\w8素敵だねー！\0\s[1]ええ。\w8古い石は好きよ、私は。\w8……長く残るものには、理由があるの。\e'
}
