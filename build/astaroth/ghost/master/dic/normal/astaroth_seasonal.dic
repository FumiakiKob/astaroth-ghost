//******************************************************************************
// アスタロト＋フルフル 季節トーク辞書 v1（2026-11-06、nar v2.25）
// 原稿: TALKS_SEASONAL.md（2026-11-06 ユーザー承認済み、全77本・18キー）
//
// 設計（原稿の設計メモを実装に落としたもの）:
//   ・日付（GETTIME の [1]=月、[2]=日。yaya_base shiori3.dic の定義に
//     準拠）で季節キーを判定し、そのキーのプールだけから引く。
//   ・月別の汎用基調の上に、行事の狭い窓（正月・節分・七夕・お盆・
//     ハロウィン・クリスマス等）を重ね、重なる期間は範囲の狭い方を
//     優先する。実装は SeasonFuncFor の if/elseif の並び順で優先度を
//     表す（先に書いた方が勝つ）。なお4月は「新年度」を「春・桜」より
//     先に置いたため、桜プールの実効期間は 3月下旬のみになる
//     （原稿の「3月下旬〜4月上旬」から、4/1 は新年度という想定で調整）。
//   ・どのキーにも当たらない日（3月前半、5月中旬以降など）は季節なし。
//   ・組み込み先は astaroth_talk.dic の TalkSelectOne: 季節キーが有効な
//     期間は先に 20％ の抽選で季節プールを引き、外れたら従来の配分
//     （時間帯25％／掛け合い45％／独白各15％）で選ぶ。季節プールも
//     RandomTalk の履歴回避（直近5件）の対象になる。
//   ・音声なし（現行方針どおり、ランダムトークは無音声）。
//   ・表情は原稿の注記どおり: アスタロト 0〜5、フルフル 10〜15。
//
// テスト用: OnAstarothSeasonTest（SSTP NOTIFY）で日付上書き
//（astaroth_season_testmonth／testday。-1 で解除）・季節プールの
// 確認・プールからの引き出しができる。上書き変数が無ければ実日付で
// 判定する（通常運用では未設定）。送信スクリプトは WSL の
// ~/sstp_seasontest.py（OnAstarothShellTest と同型）。
//
// 規律（v2.10 の教訓）: 関数呼び出しの結果は必ず代入文で受ける。
// 裸の関数呼び出し文は書かない。
//******************************************************************************

//******************************************************************************
//現在の月。テスト用上書きがあればそちらを返す
//******************************************************************************
SeasonNowMonth
{
	_m = TOINT(GETTIME[1])
	if ISVAR('astaroth_season_testmonth') {
		_t = TOINT(astaroth_season_testmonth)
		if _t >= 1 {
			_m = _t
		}
	}
	_m
}

//******************************************************************************
//現在の日。テスト用上書きがあればそちらを返す
//******************************************************************************
SeasonNowDay
{
	_d = TOINT(GETTIME[2])
	if ISVAR('astaroth_season_testday') {
		_t = TOINT(astaroth_season_testday)
		if _t >= 1 {
			_d = _t
		}
	}
	_d
}

//******************************************************************************
//月・日から季節プールの関数名を返す（どのキーにも当たらなければ ''）
// _argv[0] : 月（1〜12）／ _argv[1] : 日（1〜31）
// 並び順＝優先度（行事の狭い窓 → 月別基調）。_md は 月*100+日。
//******************************************************************************
SeasonFuncFor
{
	_m = TOINT(_argv[0])
	_d = TOINT(_argv[1])
	_md = _m * 100 + _d
	_f = ''
	if _m == 1 && _d <= 7 {
		_f = 'TalkSeasonNewYear'
	}
	elseif _md >= 202 && _md <= 204 {
		_f = 'TalkSeasonSetsubun'
	}
	elseif _md >= 213 && _md <= 214 {
		_f = 'TalkSeasonValentine'
	}
	elseif _md >= 706 && _md <= 708 {
		_f = 'TalkSeasonTanabata'
	}
	elseif _md >= 813 && _md <= 816 {
		_f = 'TalkSeasonObon'
	}
	elseif _md >= 1030 && _md <= 1031 {
		_f = 'TalkSeasonHalloween'
	}
	elseif _md >= 1224 && _md <= 1225 {
		_f = 'TalkSeasonChristmas'
	}
	elseif _md >= 1226 && _md <= 1231 {
		_f = 'TalkSeasonYearEnd'
	}
	elseif _md >= 429 && _md <= 506 {
		_f = 'TalkSeasonGW'
	}
	elseif _m == 1 {
		_f = 'TalkSeasonDeepWinter'
	}
	elseif _m == 4 {
		_f = 'TalkSeasonApril'
	}
	elseif _md >= 321 && _md <= 410 {
		_f = 'TalkSeasonSakura'
	}
	elseif _m == 6 {
		_f = 'TalkSeasonRainy'
	}
	elseif _md >= 721 && _md <= 831 {
		_f = 'TalkSeasonSummer'
	}
	elseif _m == 9 {
		_f = 'TalkSeasonTyphoon'
	}
	elseif _md >= 1121 && _md <= 1130 {
		_f = 'TalkSeasonWinterPrep'
	}
	elseif _md >= 1001 && _md <= 1130 {
		_f = 'TalkSeasonAutumn'
	}
	elseif _m == 12 || _m == 2 {
		_f = 'TalkSeasonWinter'
	}
	_f
}

//******************************************************************************
//現在の日付（テスト用上書きを含む）の季節プール関数名。なければ ''
//******************************************************************************
SeasonTalkFunc
{
	_m = SeasonNowMonth
	_d = SeasonNowDay
	_f = SeasonFuncFor(_m, _d)
	_f
}

//******************************************************************************
//テスト用フック OnAstarothSeasonTest（SSTP NOTIFY）
// Reference0:
//   'date'  : Reference1=月／Reference2=日 でテスト用日付を上書きし、
//             判定された季節プール名（なければ NONE）を返す
//   'clear' : 日付上書きを解除する
//   'key'   : 現在（上書き含む）の季節プール名を返す
//   'draw'  : 現在の季節プールから実際に1本引いて返す（季節なしなら注記）
//******************************************************************************
OnAstarothSeasonTest
{
	_result = ''
	if reference[0] == 'date' {
		astaroth_season_testmonth = TOINT(reference[1])
		astaroth_season_testday = TOINT(reference[2])
		_f = SeasonTalkFunc
		_disp = 'NONE'
		if _f != '' {
			_disp = _f
		}
		_result = '\0\s[0]テスト用日付を ' + TOSTR(TOINT(reference[1])) + '/' + TOSTR(TOINT(reference[2])) + ' に上書きしたわ。季節プール: ' + _disp + '\e'
	}
	elseif reference[0] == 'clear' {
		astaroth_season_testmonth = -1
		astaroth_season_testday = -1
		_result = '\0\s[0]テスト用日付の上書きは解除したわ。実日付で判定する。\e'
	}
	elseif reference[0] == 'key' {
		_f = SeasonTalkFunc
		_disp = 'NONE'
		if _f != '' {
			_disp = _f
		}
		_result = '\0\s[0]季節プール: ' + _disp + '\e'
	}
	elseif reference[0] == 'draw' {
		_f = SeasonTalkFunc
		if _f != '' {
			_result = EVAL(_f)
		}
		else {
			_result = '\0\s[0]いまは季節なしの時期よ。\e'
		}
	}
	_result
}

//******************************************************************************
//季節プール（原稿 TALKS_SEASONAL.md と1対1対応）
//******************************************************************************

//正月（1/1〜1/7、5本。原稿 1-1〜1-5）
TalkSeasonNewYear : nonoverlap
{
	'\1\s[11]あけましておめでとう、マスター！\w8今年の初雷、ドカーンといくよー！\0\s[3]新年早々、物騒な挨拶ね。\w8……まあ、景気付けにはなっているわ\1\s[11]今年もよろしくね、アスタロト！\0\s[1]ええ。\w8貴方も、今年もよろしくしなさい\e'
	'\1\s[10]おみくじって、人間の運試しだよねー。\w8私、大吉がいいなー！\0\s[0]引く前から結果を決めるのは、運試しとは言わないわ\1\s[11]だって私、運がいいもん！\w8根拠は自信だよー！\0\s[3]その自信の方が、大吉より強いでしょうね\e'
	'\0\s[0]年の初めに目標を立てるのは、人間も悪魔も同じよ。\w8……立てるだけで終わらせないのが、貴族の作法だけれどね\e'
	'\1\s[11]初夢は、一富士、二鷹、三茄子がいいんだって！\w8私はマスターの夢が見たいなー\0\s[0]あんたの場合は、見る側じゃなくて出る側でしょう\1\s[14]じゃあマスターの初夢に出演しちゃお！\w8大吉確定だねー！\0\s[3]茄子より格下の出演ね\e'
	'\1\s[11]お年玉、いいなー。\w8マスター、私にも何かちょうだい！\w8雷一発と交換でもいいよー！\e'
}

//寒中（1/8〜1/31、4本。原稿 2-1〜2-4）
TalkSeasonDeepWinter : nonoverlap
{
	'\0\s[0]一年で寒さが底を打つ頃よ。\w8貴方、温かいものを飲んでから取りかかりなさい\1\s[11]私は寒いの平気だよー！\w8翼を膨らませれば、もこもこだもん！\0\s[1]鳥みたいな防寒ね\e'
	'\1\s[10]寒い日はね、あったかい場所にみんな集まるんだよねー\0\s[0]人も獣も悪魔も、そこは同じね\1\s[14]じゃあ私も、マスターのそばに集まっちゃおー\0\s[3]集まる、という距離感ではないでしょう\e'
	'\0\s[0]寒さの底は、春の入口でもあるのよ。\w8冷たい日が続くほど、芽吹きの気配は濃くなる\e'
	'\1\s[12]さ、寒い！\w8私の雷、今日はカチカチに凍っちゃうかも……！\0\s[0]雷は凍らないわ。\w8凍っているのは、あんたの頬でしょう\1\s[13]頬っぺ、あっためてー\0\s[3]自分の翼で包みなさい\e'
}

//節分（2/2〜2/4、4本。原稿 3-1〜3-4）
TalkSeasonSetsubun : nonoverlap
{
	'\1\s[11]節分だよー！\w8鬼は外、福は内！\w8……あれ、私たち悪魔はどっち側？\0\s[0]堕天使は鬼の枠には入らないわ。\w8豆の的にもしないで\1\s[10]じゃあ私は福の側！\w8マスターに福を配る係だよー！\0\s[1]配るのは豆じゃないでしょうね\e'
	'\1\s[10]年の数だけ豆を食べるんだって。\w8私の分、何個になるのかなー\0\s[3]数えるな、フルフル。\w8数えた者から老けるわ\1\s[11]じゃあ永遠に数えない！\w8私はずっとこのままだよー！\e'
	'\0\s[0]季節を分ける日、というのは悪くない考えね。\w8区切りがあるから、人は心を入れ替えられる\e'
	'\1\s[12]豆まきの豆、拾って食べたら雷の力になるかなー？\0\s[0]ならないわ。\w8……ただし、恵方を向いて黙って食べる太巻き、あれは少し興味がある\1\s[11]アスタロト、食いしん坊な一面あるよねー\0\s[3]黙って食べる作法に、興味があるだけよ\e'
}

//バレンタイン（2/13〜2/14、4本。原稿 4-1〜4-4）
TalkSeasonValentine : nonoverlap
{
	'\1\s[14]バレンタインだよ、マスター！\w8私からのチョコ、受け取ってくれる？\0\s[2]その大きさ……雷の形をしたチョコレート、こんなに大きいの？\1\s[11]気持ちが大きいからだよー！\0\s[4]……貴方、一緒に分けなさい。\w8私一人では、色々と無理よ\e'
	'\1\s[10]人間ってこの日、渡すまでドキドキするんだって。\w8可愛いよねー\0\s[0]渡す勇気より、渡した後の方が長いのにね\1\s[14]私は渡す前からドキドキだもん！\w8……あれ、これも恋のうち？\0\s[1]あんたの場合、年中そうでしょう\e'
	'\0\s[0]気持ちを物に託す日、か。\w8……素直な習慣ね。\w8悪魔には、少し眩しいくらい\e'
	'\1\s[11]義理チョコと本命チョコ、違いは気持ちの分量だよねー！\0\s[0]あんたに義理という概念があるとは思えないけれど\1\s[14]私のは全部、本命特大サイズだもん！\0\s[3]誰にでも、でしょう\e'
}

//春・桜（3/21〜3/31、5本。原稿 5-1〜5-5）
TalkSeasonSakura : nonoverlap
{
	'\1\s[11]桜が咲いたよー！\w8ピンクの花、私のドレスとお揃いだねー！\0\s[1]今日ばかりは、あんたの言い分を認めるわ。\w8……空ごとピンクだもの\1\s[11]私の季節が来たー！\0\s[0]調子に乗りすぎないで。\w8散るのも早い花よ\e'
	'\0\s[0]桜は、咲く前より散る時の方が騒がれる花ね。\w8短いものの宿命かしら\1\s[10]散る花びら、キャッチできたら恋が叶うって言わない？\0\s[1]言うわね。\w8……ほら、あんたの頭に一枚\1\s[14]やったー！\w8じゃあ私の恋、確定だねー！\e'
	'\0\s[5]花の香りは、記憶に直結するのよ。\w8何百年経っても、同じ春の匂いがする\e'
	'\1\s[10]お花見って、花を見る口実でお菓子を食べる会だよねー\0\s[0]半分は正解よ。\w8残り半分は、春が来たことを皆で確かめる儀式\1\s[11]じゃあ私も確かめる！\w8お菓子で！\0\s[3]結局そっちね\e'
	'\1\s[11]桜吹雪の中で雷を落としたら、ピンクとピカピカで最強に可愛いと思うのー！\w8アスタロトに止められたけど！\e'
}

//新年度（4月、4本。原稿 6-1〜6-4。ただし 4/29〜4/30 は GW が優先）
TalkSeasonApril : nonoverlap
{
	'\1\s[11]四月！\w8新しいカレンダー、新しいノート！\w8私も心機一転するよー！\0\s[3]一転する宣言は毎月聞いている気がするわ\1\s[10]毎月新しい私だもん！\0\s[0]……それはそれで、一貫しているわね\e'
	'\0\s[0]新しい環境に身を置くのは、誰でも少し緊張するものよ。\w8貴方も、無理に馴染もうと焦らないで\1\s[11]緊張したら、私が恋の雷でほぐすよー！\0\s[3]ほぐすどころか、余計に硬直するでしょう\e'
	'\1\s[10]新入生って、みんなちょっと大きいカバン持ってるよねー\0\s[1]荷物が多いのは、期待と不安の重さよ\1\s[14]私のカバンには、恋だけ詰まってるもん！\w8軽いよー！\0\s[3]軽すぎるのも問題ね\e'
	'\0\s[0]始まりの月は、未熟さが許される月よ。\w8完璧に始めようとしないで、まず一歩だけ出しなさい\e'
}

//GW・新緑（4/29〜5/6、4本。原稿 7-1〜7-4）
TalkSeasonGW : nonoverlap
{
	'\1\s[11]連休だよー、マスター！\w8お休みの計画、私はもう決まってるもん！\0\s[0]聞いてみましょう\1\s[11]マスターと一緒！\w8以上！\0\s[3]計画とは言えないわ、それは願望でしょう\e'
	'\0\s[0]新緑の緑は、若い色ね。\w8目に優しいというのは、本当だと思うわ\1\s[10]私のピンクと並べたら、春の最強コンビだねー！\0\s[1]……まあ、悪くない眺めでしょう\e'
	'\0\s[0]休みは、休むためにあるのよ。\w8予定で埋め尽くすのは、休みの使い方としては二流ね\e'
	'\1\s[12]五月なのに、なんだかぼんやりするー。\w8これが噂の五月病？\0\s[0]あんたは年中ぼんやりでしょう\1\s[13]じゃあ私は年中、五月なのかー\0\s[1]開き直りの速さだけは年中無休ね\e'
}

